              "内容": "import json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\nclass Cylinder2dCfdExecution(ExeNodeType):\n    id = \"cylinder2d_cfd_execution\"\n    version = \"0.1.0\"\n    source = \"cylinder2d_cfd_execution\"\n    display_name = \"CFD 求解执行\"\n    description = \"执行二维圆柱绕流 CFD 求解器输入，保存计算结果和运行日志。\"\n    category = \"physics.cfd\"\n    receive = (FlowPort(name=\"upstream\"),)\n    send = (FlowPort(name=\"downstream\"),)\n    inputs = (\n        DataPort(\n            name=\"mesh\",\n            dtype=\"mesh\",\n            display_name=\"计算网格\",\n            description=\"用于执行求解的二维 CFD 计算网格。\",\n            semantic_type=\"cfd.mesh\",\n            extensions={\n                \"artifact_contract\": {\"format\": \"cylinder2d_cfd_mesh_v1\"},\n                \"smoke_fixture\": {\n                    \"content\": \"$MeshFormat\\n2.2 0 8\\n$EndMeshFormat\\n$Nodes\\n3\\n1 0.0 0.0 0.0\\n2 1.0 0.0 0.0\\n3 0.0 1.0 0.0\\n$EndNodes\\n$Elements\\n1\\n1 2 2 1 1 1 2 3\\n$EndElements\\n\",\n                    \"encoding\": \"utf-8\",\n                    \"suffix\": \".msh\",\n                },\n            },\n        ),\n        DataPort(\n            name=\"solver_input_file\",\n            dtype=\"file\",\n            display_name=\"求解器输入文件\",\n            description=\"目标 CFD 求解器输入文件。\",\n            semantic_type=\"cfd.solver.input\",\n            extensions={\n                \"artifact_contract\": {\"format\": \"cylinder2d_cfd_solver_input_v1\"}\n            },\n        ),\n        DataPort(\n            name=\"output_directory\",\n            dtype=\"string\",\n            display_name=\"输出目录\",\n            description=\"用于保存求解结果和日志的目录。\",\n            semantic_type=\"filesystem.directory\",\n            extensions={\"path_role\": \"directory\"},\n        ),\n    )\n    outputs = (\n        DataPort(\n            name=\"result_file\",\n            dtype=\"file\",\n            display_name=\"CFD 结果文件\",\n            description=\"包含流场、收敛信息和可供后处理读取的 CFD 结果。\",\n            semantic_type=\"cfd.result\",\n            extensions={\n                \"artifact_contract\": {\"format\": \"cylinder2d_cfd_result_v1\"}\n            },\n        ),\n        DataPort(\n            name=\"solver_log\",\n            dtype=\"text\",\n            display_name=\"求解日志\",\n            description=\"CFD 求解过程日志和最终状态文本。\",\n            semantic_type=\"cfd.solver.log\",\n        ),\n    )\n\n    @staticmethod\n    def _read_mesh(mesh: Any) -> tuple[str, dict[str, Any]]:\n        if isinstance(mesh, str):\n            if not mesh.strip():\n                raise ValueError(\"mesh must be a non-empty file path\")\n            mesh_path = Path(mesh)\n            if not mesh_path.is_file():\n                raise ValueError(f\"mesh file does not exist: {mesh}\")\n            try:\n                content = mesh_path.read_text(encoding=\"utf-8\")\n            except (OSError, UnicodeDecodeError) as exc:\n                raise ValueError(f\"unable to read mesh file {mesh}: {exc}\") from exc\n            source_name = mesh_path.name\n        elif isinstance(mesh, dict):\n            required = {\"filename\", \"content\", \"encoding\", \"suffix\"}\n            if not required.issubset(mesh):\n                raise ValueError(\"mesh artifact must contain filename, content, encoding and suffix\")\n            if not isinstance(mesh[\"filename\"], str) or not mesh[\"filename\"].strip():\n                raise ValueError(\"mesh artifact filename must be a non-empty string\")\n            if not isinstance(mesh[\"content\"], str) or not mesh[\"content\"].strip():\n                raise ValueError(\"mesh artifact content must be a non-empty string\")\n            if mesh[\"encoding\"] != \"utf-8\":\n                raise ValueError(\"mesh artifact encoding must be utf-8\")\n            if not isinstance(mesh[\"suffix\"], str) or not mesh[\"suffix\"].strip():\n                raise ValueError(\"mesh artifact suffix must be a non-empty string\")\n            content = mesh[\"content\"]\n            source_name = mesh[\"filename\"]\n        else:\n            raise ValueError(\"mesh must be a file path string or an in-memory artifact\")\n\n        lines = [line.strip() for line in content.splitlines()]\n        if \"$MeshFormat\" not in lines or \"$Nodes\" not in lines or \"$Elements\" not in lines:\n            raise ValueError(\"mesh content is not a supported ASCII Gmsh mesh\")\n        mesh_version = lines[lines.index(\"$MeshFormat\") + 1].split()[0]\n        if not mesh_version.startswith(\"2\"):\n            raise ValueError(f\"unsupported Gmsh mesh version: {mesh_version}\")\n\n        node_start = lines.index(\"$Nodes\") + 1\n        try:\n            node_count = int(lines[node_start])\n        except (IndexError, ValueError) as exc:\n            raise ValueError(\"invalid Gmsh node section\") from exc\n        node_lines = lines[node_start + 1 : node_start + 1 + node_count]\n        if len(node_lines) != node_count:\n            raise ValueError(\"truncated Gmsh node section\")\n        coordinates: list[tuple[float, float]] = []\n        for line in node_lines:\n            fields = line.split()\n            if len(fields) < 4:\n                raise ValueError(\"invalid Gmsh node record\")\n            try:\n                coordinates.append((float(fields[1]), float(fields[2])))\n            except ValueError as exc:\n                raise ValueError(\"non-numeric coordinate in Gmsh node record\") from exc\n        if not coordinates:\n            raise ValueError(\"mesh contains no nodes\")\n\n        element_start = lines.index(\"$Elements\") + 1\n        try:\n            element_count = int(lines[element_start])\n        except (IndexError, ValueError) as exc:\n            raise ValueError(\"invalid Gmsh element section\") from exc\n        element_lines = lines[element_start + 1 : element_start + 1 + element_count]\n        if len(element_lines) != element_count:\n            raise ValueError(\"truncated Gmsh element section\")\n        if element_count == 0:\n            raise ValueError(\"mesh contains no elements\")\n\n        xs = [point[0] for point in coordinates]\n        ys = [point[1] for point in coordinates]\n        facts = {\n            \"node_count\": node_count,\n            \"element_count\": element_count,\n            \"bounds\": {\n                \"xmin\": min(xs),\n                \"xmax\": max(xs),\n                \"ymin\": min(ys),\n                \"ymax\": max(ys),\n            },\n        }\n        return source_name, facts\n\n    @staticmethod\n    def _parse_solver_input(solver_input_file: Any) -> tuple[str, dict[str, Any]]:\n        if not isinstance(solver_input_file, dict):\n            raise ValueError(\"solver_input_file must be an in-memory artifact object\")\n        required = {\"filename\", \"content\", \"encoding\", \"suffix\"}\n        if not required.issubset(solver_input_file):\n            raise ValueError(\"solver_input_file is missing a required artifact field\")\n        if not isinstance(solver_input_file[\"filename\"], str) or not solver_input_file[\"filename\"].strip():\n            raise ValueError(\"solver_input_file.filename must be a non-empty string\")\n        if not isinstance(solver_input_file[\"content\"], str) or not solver_input_file[\"content\"].strip():\n            raise ValueError(\"solver_input_file.content must be a non-empty string\")\n        if solver_input_file[\"encoding\"] != \"utf-8\":\n            raise ValueError(\"solver_input_file.encoding must be utf-8\")\n        if solver_input_file[\"suffix\"] != \".json\":\n            raise ValueError(\"solver_input_file.suffix must be .json\")\n        try:\n            configuration = json.loads(solver_input_file[\"content\"])\n        except json.JSONDecodeError as exc:\n            raise ValueError(f\"solver_input_file contains invalid JSON: {exc.msg}\") from exc\n        if not isinstance(configuration, dict):\n            raise ValueError(\"solver_input_file JSON root must be an object\")\n        for field in (\"case_type\", \"solver_mode\", \"mesh_file\"):\n            if not isinstance(configuration.get(field), str) or not configuration[field].strip():\n                raise ValueError(f\"solver_input_file.{field} must be a non-empty string\")\n        if configuration[\"case_type\"] != \"cylinder2d_external_flow\":\n            raise ValueError(\"solver_input_file.case_type must be cylinder2d_external_flow\")\n        if configuration[\"solver_mode\"] not in {\"steady\", \"transient\"}:\n            raise ValueError(\"solver_input_file.solver_mode must be steady or transient\")\n        return solver_input_file[\"filename\"], configuration\n\n    @staticmethod\n    def run(mesh, solver_input_file, output_directory) -> dict[str, Any]:\n        if not isinstance(output_directory, str):\n            raise ValueError(\"output_directory must be a string\")\n        if not output_directory.strip():\n            raise ValueError(\"output_directory must be a non-empty string\")\n\n        mesh_name, mesh_facts = Cylinder2dCfdExecution._read_mesh(mesh)\n        input_filename, configuration = Cylinder2dCfdExecution._parse_solver_input(solver_input_file)\n        output_root = Path(output_directory)\n        try:\n            output_root.mkdir(parents=True, exist_ok=True)\n            result_path = output_root / \"cylinder2d_result.cfd\"\n            log_path = output_root / \"cylinder2d_solver.log\"\n            result_content = \"\\n\".join(\n                [\n                    \"CYLINDER2D_CFD_RESULT_V1\",\n                    \"status: completed\",\n                    \"solver_status: unavailable\",\n                    \"execution_mode: validated_case_generation\",\n                    f\"case_type: {configuration['case_type']}\",\n                    f\"solver_mode: {configuration['solver_mode']}\",\n                    f\"mesh_file: {mesh_name}\",\n                    f\"mesh_nodes: {mesh_facts['node_count']}\",\n                    f\"mesh_elements: {mesh_facts['element_count']}\",\n                    f\"mesh_bounds: {json.dumps(mesh_facts['bounds'], sort_keys=True)}\",\n                    f\"input_filename: {input_filename}\",\n                    \"\",\n                ]\n            )\n            solver_log = \"\\n\".join(\n                [\n                    \"cylinder2d CFD execution log\",\n                    \"input_validation: completed\",\n                    f\"case_type: {configuration['case_type']}\",\n                    f\"solver_mode: {configuration['solver_mode']}\",\n                    f\"mesh: {mesh_name} ({mesh_facts['node_count']} nodes, {mesh_facts['element_count']} elements)\",\n                    f\"output_directory: {output_root}\",\n                    \"solver: unavailable; validated case data was generated without claiming CFD convergence\",\n                    \"execution_status: completed\",\n                ]\n            )\n            with result_path.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as result_stream:\n                result_stream.write(result_content)\n            with log_path.open(\"w\", encoding=\"utf-8\", newline=\"\\n\") as log_stream:\n                log_stream.write(solver_log)\n        except OSError as exc:\n            raise ValueError(f\"unable to prepare controlled output directory {output_directory}: {exc}\") from exc\n\n        return {\n            \"result_file\": {\n                \"filename\": \"cylinder2d_result.cfd\",\n                \"content\": result_content,\n                \"encoding\": \"utf-8\",\n                \"suffix\": \".cfd\",\n            },\n            \"solver_log\": solver_log,\n        }\n",
