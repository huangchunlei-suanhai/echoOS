l,\n        \"minimum\": null,\n        \"name\": \"report\",\n        \"semantic_type\": \"cfd.postprocess.report\",\n        \"tags\": [],\n        \"unit\": null\n      },\n      {\n        \"default\": null,\n        \"description\": \"包含收敛状态、基础统计量及可计算流动特征的结构化指标。\",\n        \"display_name\": \"后处理指标\",\n        \"dtype\": \"dict\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"metrics\",\n        \"semantic_type\": \"cfd.postprocess.metrics\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"receive\": [\n      {\n        \"description\": \"上游控制流入口。\",\n        \"display_name\": \"上游\",\n        \"name\": \"upstream\"\n      }\n    ],\n    \"send\": [\n      {\n        \"description\": \"下游控制流出口。\",\n        \"display_name\": \"下游\",\n        \"name\": \"downstream\"\n      }\n    ],\n    \"source\": \"cylinder2d_cfd_postprocessor\",\n    \"tags\": [\n      \"cfd\",\n      \"postprocessing\",\n      \"result-analysis\",\n      \"report\",\n      \"metrics\"\n    ]\n  },\n  \"runtime_hints\": {},\n  \"version\": \"0.1.0\"\n}\n",
