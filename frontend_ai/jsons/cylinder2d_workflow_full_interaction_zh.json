              "内容": "from __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\nclass Cylinder2dSolverInputGenerator(ExeNodeType):\n    id = \"cylinder2d_solver_input_generator\"\n    version = \"0.1.0\"\n    source = \"workflow_contract_840b8062248b4f25b2718e757d8da67a\"\n    display_name = \"CFD 求解输入生成\"\n    description = \"将计算网格和工况定义转换为目标 CFD 求解器所需的求解输入文件。\"\n    category = \"dataio.config\"\n    receive = (FlowPort(name=\"upstream\"),)\n    send = (FlowPort(name=\"downstream\"),)\n    inputs = (\n        DataPort(\n            name=\"mesh\",\n            dtype=\"mesh\",\n            display_name=\"计算网格\",\n            description=\"二维 CFD 计算网格。\",\n            semantic_type=\"cfd.mesh\",\n            unit=None,\n            extensions={\"artifact_contract\": {\"format\": \"cylinder2d_cfd_mesh_v1\"}},\n        ),\n        DataPort(\n            name=\"case_definition\",\n            dtype=\"dict\",\n            display_name=\"CFD 工况定义\",\n            description=\"流体物性、边界条件和求解模式定义。\",\n            semantic_type=\"cfd.case.definition\",\n            unit=None,\n            extensions={},\n        ),\n        DataPort(\n            name=\"output_directory\",\n            dtype=\"string\",\n            display_name=\"输出目录\",\n            description=\"用于保存求解器输入文件的目录。\",\n            semantic_type=\"filesystem.directory\",\n            unit=None,\n            extensions={},\n        ),\n    )\n    outputs = (\n        DataPort(\n            name=\"solver_input_file\",\n            dtype=\"file\",\n            display_name=\"求解器输入文件\",\n            description=\"可供 CFD 执行节点消费的目标求解器输入文件。\",\n            semantic_type=\"cfd.solver.input\",\n            unit=None,\n            extensions={\"artifact_contract\": {\"format\": \"cylinder2d_cfd_solver_input_v1\"}},\n        ),\n    )\n\n    @staticmethod\n    def _read_mesh(mesh: Any) -> tuple[str, dict[str, Any]]:\n        if isinstance(mesh, str):\n            if not mesh.strip():\n                raise ValueError(\"mesh 必须是非空受控文件路径\")\n            mesh_path = Path(mesh)\n            if not mesh_path.is_file():\n                raise ValueError(f\"mesh 文件不存在: {mesh}\")\n            try:\n                content = mesh_path.read_text(encoding=\"utf-8\")\n            except (OSError, UnicodeError) as exc:\n                raise ValueError(f\"mesh 文件不可读: {mesh}\") from exc\n            filename = mesh_path.name\n        elif isinstance(mesh, dict):\n            required = {\"filename\", \"content\", \"encoding\", \"suffix\"}\n            if set(mesh) - required - {\"artifact_contract\"}:\n                raise ValueError(\"mesh 内存产物包含未声明字段\")\n            if not required.issubset(mesh):\n                raise ValueError(\"mesh 内存产物缺少 filename、content、encoding 或 suffix\")\n            if not isinstance(mesh[\"filename\"], str) or not mesh[\"filename\"].strip():\n                raise ValueError(\"mesh.filename 必须是非空字符串\")\n            if not isinstance(mesh[\"content\"], str) or not mesh[\"content\"]:\n                raise ValueError(\"mesh.content 必须是非空字符串\")\n            if mesh[\"encoding\"] != \"utf-8\":\n                raise ValueError(\"mesh.encoding 必须为 utf-8\")\n            if not isinstance(mesh[\"suffix\"], str) or not mesh[\"suffix\"].startswith(\".\"):\n                raise ValueError(\"mesh.suffix 必须是扩展名\")\n            filename = mesh[\"filename\"]\n            content = mesh[\"content\"]\n        else:\n            raise ValueError(\"mesh 必须是文件路径字符串或内存文件产物\")\n\n        statistics = Cylinder2dSolverInputGenerator._parse_msh(content)\n        return filename, statistics\n\n    @staticmethod\n    def _parse_msh(content: str) -> dict[str, Any]:\n        lines = [line.strip() for line in content.splitlines()]\n        if \"$MeshFormat\" not in lines or \"$EndMeshFormat\" not in lines:\n            raise ValueError(\"mesh 不是可识别的 Gmsh ASCII 文件\")\n        try:\n            version_line = lines[lines.index(\"$MeshFormat\") + 1]\n            version = version_line.split()[0]\n        except (ValueError, IndexError) as exc:\n            raise ValueError(\"mesh 缺少有效的 Gmsh 版本信息\") from exc\n        if version not in {\"2.2\", \"4.1\"}:\n            raise ValueError(f\"不支持的 Gmsh 版本: {version}\")\n\n        node_count = 0\n        element_count = 0\n        element_types: dict[str, int] = {}\n        if \"$Nodes\" in lines:\n            start = lines.index(\"$Nodes\") + 1\n            end = lines.index(\"$EndNodes\", start)\n            if version.startswith(\"2.\"):\n                if end <= start:\n                    raise ValueError(\"mesh 的节点段为空\")\n                node_count = int(lines[start].split()[0])\n                node_records = end - start - 1\n                if node_count <= 0 or node_records < node_count:\n                    raise ValueError(\"mesh 的节点数据不完整\")\n            else:\n                if end <= start:\n                    raise ValueError(\"mesh 的节点段为空\")\n                header = lines[start].split()\n                if len(header) < 2:\n                    raise ValueError(\"mesh 的 4.1 节点段头部无效\")\n                node_count = int(header[1])\n                if node_count <= 0:\n                    raise ValueError(\"mesh 必须包含节点\")\n        else:\n            raise ValueError(\"mesh 缺少节点段\")\n\n        if \"$Elements\" in lines:\n            start = lines.index(\"$Elements\") + 1\n            end = lines.index(\"$EndElements\", start)\n            if end <= start:\n                raise ValueError(\"mesh 的单元段为空\")\n            if version.startswith(\"2.\"):\n                declared = int(lines[start].split()[0])\n                records = lines[start + 1 : end]\n                if declared <= 0 or len(records) < declared:\n                    raise ValueError(\"mesh 的单元数据不完整\")\n                for record in records[:declared]:\n                    fields = record.split()\n                    if len(fields) < 3:\n                        raise ValueError(\"mesh 单元记录无效\")\n                    element_type = fields[1]\n                    element_types[element_type] = element_types.get(element_type, 0) + 1\n                element_count = declared\n            else:\n                header = lines[start].split()\n                if len(header) < 2:\n                    raise ValueError(\"mesh 的 4.1 单元段头部无效\")\n                element_count = int(header[1])\n                if element_count <= 0:\n                    raise ValueError(\"mesh 必须包含单元\")\n                records = lines[start + 1 : end]\n                for record in records:\n                    fields = record.split()\n                    if len(fields) >= 2:\n                        element_type = fields[1]\n                        element_types[element_type] = element_types.get(element_type, 0) + 1\n        else:\n            raise ValueError(\"mesh 缺少单元段\")\n        if element_count <= 0:\n            raise ValueError(\"mesh 必须包含至少一个单元\")\n        return {\n            \"format\": \"gmsh_ascii\",\n            \"version\": version,\n            \"node_count\": node_count,\n            \"element_count\": element_count,\n            \"element_types\": dict(sorted(element_types.items())),\n        }\n\n    @staticmethod\n    def _validate_case(case_definition: Any) -> dict[str, Any]:\n        if not isinstance(case_definition, dict):\n            raise ValueError(\"case_definition 必须是对象\")\n        required = {\n            \"inlet_velocity\",\n            \"fluid_density\",\n            \"fluid_viscosity\",\n            \"solver_mode\",\n            \"boundary_regions\",\n            \"output_directory\",\n        }\n        if set(case_definition) != required:\n            missing = sorted(required - set(case_definition))\n            extra = sorted(set(case_definition) - required)\n            details = []\n            if missing:\n                details.append(f\"缺少字段 {missing}\")\n            if extra:\n                details.append(f\"包含未声明字段 {extra}\")\n            raise ValueError(\"case_definition 字段不符合合同: \" + \", \".join(details))\n        for name, minimum in ((\"inlet_velocity\", 1e-6), (\"fluid_density\", 1e-6), (\"fluid_viscosity\", 1e-12)):\n            value = case_definition[name]\n            if isinstance(value, bool) or not isinstance(value, (int, float)) or value < minimum:\n                raise ValueError(f\"{name} 必须是不小于 {minimum} 的数值\")\n        if case_definition[\"solver_mode\"] not in {\"steady\", \"transient\"}:\n            raise ValueError(\"solver_mode 必须为 steady 或 transient\")\n        regions = case_definition[\"boundary_regions\"]\n        expected_regions = {\"inlet\", \"outlet\", \"cylinder\", \"walls\"}\n        if not isinstance(regions, dict) or set(regions) != expected_regions:\n            raise ValueError(\"boundary_regions 必须包含且仅包含 inlet、outlet、cylinder、walls\")\n        if any(not isinstance(regions[name], str) or not regions[name].strip() for name in expected_regions):\n            raise ValueError(\"boundary_regions 中的区域名称必须为非空字符串\")\n        if not isinstance(case_definition[\"output_directory\"], str) or not case_definition[\"output_directory\"].strip():\n            raise ValueError(\"case_definition.output_directory 必须为非空字符串\")\n        return case_definition\n\n    @staticmethod\n    def run(mesh, case_definition, output_directory) -> dict[str, Any]:\n        if not isinstance(output_directory, str) or not output_directory.strip():\n            raise ValueError(\"output_directory 必须是非空字符串\")\n        case = Cylinder2dSolverInputGenerator._validate_case(case_definition)\n        mesh_filename, mesh_statistics = Cylinder2dSolverInputGenerator._read_mesh(mesh)\n        output_root = Path(output_directory)\n        output_root.mkdir(parents=True, exist_ok=True)\n        output_path = output_root / \"solver_input.json\"\n        payload = {\n            \"case_type\": \"cylinder2d_external_flow\",\n            \"solver_mode\": case[\"solver_mode\"],\n            \"fluid\": {\n                \"density\": case[\"fluid_density\"],\n                \"dynamic_viscosity\": case[\"fluid_viscosity\"],\n                \"inlet_velocity\": case[\"inlet_velocity\"],\n            },\n            \"boundary_regions\": case[\"boundary_regions\"],\n            \"mesh_file\": mesh_filename,\n            \"mesh_statistics\": mesh_statistics,\n            \"output_directory\": str(output_root),\n            \"case_output_directory\": case[\"output_directory\"],\n        }\n        content = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n        try:\n            output_path.write_text(content, encoding=\"utf-8\")\n        except OSError as exc:\n            raise ValueError(f\"求解器输入文件写入失败: {output_path}\") from exc\n        return {\n            \"solver_input_file\": {\n                \"filename\": output_path.name,\n                \"content\": content,\n                \"encoding\": \"utf-8\",\n                \"suffix\": \".json\",\n            }\n        }\n",
