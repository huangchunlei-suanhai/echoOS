tensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"output_directory\",\n        \"semantic_type\": \"filesystem.directory\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"outputs\": [\n      {\n        \"default\": null,\n        \"description\": \"包含流场、收敛信息和可供后处理读取的 CFD 结果。\",\n        \"display_name\": \"CFD 结果文件\",\n        \"dtype\": \"file\",\n        \"extensions\": {\n          \"artifact_contract\": {\n            \"format\": \"cylinder2d_cfd_result_v1\"\n          }\n        },\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"result_file\",\n        \"semantic_type\": \"cfd.result\",\n        \"tags\": [],\n        \"unit\": null\n      },\n      {\n        \"default\": null,\n        \"description\": \"CFD 求解过程日志和最终状态文本。\",\n        \"display_name\": \"求解日志\",\n        \"dtype\": \"text\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"solver_log\",\n        \"semantic_type\": \"cfd.solver.log\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"receive\": [\n      {\n        \"description\": \"上游控制流入口。\",\n        \"display_name\": \"上游\",\n        \"name\": \"upstream\"\n      }\n    ],\n    \"send\": [\n      {\n        \"description\": \"下游控制流出口。\",\n        \"display_name\": \"下游\",\n        \"name\": \"downstream\"\n      }\n    ],\n    \"source\": \"cylinder2d_cfd_execution\",\n    \"tags\": [\n      \"cfd\",\n      \"solver-execution\",\n      \"cylinder-flow\",\n      \"steady\",\n      \"transient\"\n    ]\n  },\n  \"runtime_hints\": {},\n  \"version\": \"0.1.0\"\n}\n",
