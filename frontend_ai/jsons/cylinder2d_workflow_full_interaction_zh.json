                "用途": "CGraph 节点执行入口",
                "内容": "import json\nimport re\nfrom pathlib import Path\nfrom typing import Any\n\nimport numpy as np\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\nclass Cylinder2dCfdPostprocessor(ExeNodeType):\n    id = \"cylinder2d_cfd_postprocessor\"\n    version = \"0.1.0\"\n    source = \"cylinder2d_cfd_postprocessor\"\n    display_name = \"CFD 结果后处理\"\n    description = \"读取 CFD 结果文件，生成通用文本报告和结构化指标摘要，并将后处理产物保存到输出目录。\"\n    category = \"result.evaluation\"\n    receive = (FlowPort(name=\"upstream\"),)\n    send = (FlowPort(name=\"downstream\"),)\n    inputs = (\n        DataPort(\n            name=\"result_file\",\n            dtype=\"file\",\n            display_name=\"CFD 结果文件\",\n            description=\"由 CFD 执行节点生成的结果文件。\",\n            default=None,\n            minimum=None,\n            maximum=None,\n            max_length=None,\n            items=[],\n            semantic_type=\"cfd.result\",\n            unit=None,\n            extensions={\"artifact_contract\": {\"format\": \"cylinder2d_cfd_result_v1\"}},\n        ),\n        DataPort(\n            name=\"output_directory\",\n            dtype=\"string\",\n            display_name=\"输出目录\",\n            description=\"用于保存后处理报告和指标文件的目录。\",\n            default=None,\n            minimum=None,\n            maximum=None,\n            max_length=None,\n            items=[],\n            semantic_type=\"filesystem.directory\",\n            unit=None,\n            extensions={},\n        ),\n    )\n    outputs = (\n        DataPort(\n            name=\"report\",\n            dtype=\"text\",\n            display_name=\"后处理报告\",\n            description=\"包含求解状态、结果摘要和可用场变量概览的纯文本报告。\",\n            default=None,\n            minimum=None,\n            maximum=None,\n            max_length=None,\n            items=[],\n            semantic_type=\"cfd.postprocess.report\",\n            unit=None,\n            extensions={},\n        ),\n        DataPort(\n            name=\"metrics\",\n            dtype=\"dict\",\n            display_name=\"后处理指标\",\n            description=\"包含收敛状态、基础统计量及可计算流动特征的结构化指标。\",\n            default=None,\n            minimum=None,\n            maximum=None,\n            max_length=None,\n            items=[],\n            semantic_type=\"cfd.postprocess.metrics\",\n            unit=None,\n            extensions={},\n        ),\n    )\n\n    @staticmethod\n    def _read_artifact(result_file: Any) -> tuple[str, str, str, str]:\n        if isinstance(result_file, dict):\n            required = (\"filename\", \"content\", \"encoding\", \"suffix\")\n            missing = [name for name in required if name not in result_file]\n            if missing:\n                raise ValueError(\"result_file 缺少必需字段: \" + \", \".join(missing))\n            if set(result_file) != set(required):\n                raise ValueError(\"result_file 包含未声明字段\")\n            filename = result_file[\"filename\"]\n            content = result_file[\"content\"]\n            encoding = result_file[\"encoding\"]\n            suffix = result_file[\"suffix\"]\n            if not isinstance(filename, str) or not filename.strip():\n                raise ValueError(\"result_file.filename 必须为非空字符串\")\n            if not isinstance(content, str):\n                raise ValueError(\"result_file.content 必须为字符串\")\n            if encoding != \"utf-8\":\n                raise ValueError(\"result_file.encoding 必须为 utf-8\")\n            if not isinstance(suffix, str) or not suffix:\n                raise ValueError(\"result_file.suffix 必须为非空字符串\")\n            if suffix != \".cfd\":\n                raise ValueError(\"result_file.suffix 必须为 .cfd\")\n            return filename, content, encoding, suffix\n\n        if isinstance(result_file, str) and result_file.strip():\n            path = Path(result_file)\n            if path.suffix != \".cfd\":\n                raise ValueError(\"结果文件路径必须使用 .cfd 后缀\")\n            try:\n                content = path.read_text(encoding=\"utf-8\")\n            except (OSError, UnicodeError) as exc:\n                raise ValueError(f\"无法读取 CFD 结果文件: {exc}\") from exc\n            if not path.name:\n                raise ValueError(\"结果文件名不能为空\")\n            return path.name, content, \"utf-8\", \".cfd\"\n\n        raise ValueError(\"result_file 必须是完整内存工件或 UTF-8 .cfd 文件路径\")\n\n    @staticmethod\n    def _parse_result(content: str) -> tuple[str, bool, int, dict[str, float]]:\n        if not content.strip():\n            raise ValueError(\"CFD 结果内容不能为空\")\n        lines = [line.strip() for line in content.splitlines() if line.strip()]\n        if not lines or lines[0] != \"CYLINDER2D_CFD_RESULT_V1\":\n            raise ValueError(\"不支持的 CFD 结果格式，要求 cylinder2d_cfd_result_v1\")\n\n        values: dict[str, str] = {}\n        for line in lines[1:]:\n            if \":\" not in line:\n                raise ValueError(f\"无法解析结果行: {line}\")\n            key, value = (part.strip() for part in line.split(\":\", 1))\n            if not key or not value:\n                raise ValueError(f\"结果字段无效: {line}\")\n            values[key] = value\n\n        status = values.get(\"status\")\n        if status not in {\"converged\", \"not_converged\", \"failed\"}:\n            raise ValueError(\"结果必须包含有效的 status: converged、not_converged 或 failed\")\n\n        iterations = 0\n        if \"iterations\" in values:\n            if not re.fullmatch(r\"(?:0|[1-9][0-9]*)\", values[\"iterations\"]):\n                raise ValueError(\"iterations 必须为非负整数\")\n            iterations = int(values[\"iterations\"])\n\n        field_statistics: dict[str, float] = {}\n        excluded = {\"status\", \"iterations\", \"converged\", \"format\", \"version\", \"message\"}\n        for key, raw_value in values.items():\n            if key in excluded:\n                continue\n            try:\n                number = float(raw_value)\n            except ValueError as exc:\n                raise ValueError(f\"场变量统计量 {key} 必须为数值\") from exc\n            if not bool(np.isfinite(number)):\n                raise ValueError(f\"场变量统计量 {key} 必须为有限数值\")\n            field_statistics[key] = number\n\n        if \"converged\" in values:\n            expected = \"true\" if status == \"converged\" else \"false\"\n            if values[\"converged\"].lower() != expected:\n                raise ValueError(\"converged 与 status 不一致\")\n\n        return status, status == \"converged\", iterations, field_statistics\n\n    @staticmethod\n    def run(result_file, output_directory) -> dict[str, Any]:\n        if not isinstance(output_directory, str) or not output_directory.strip():\n            raise ValueError(\"output_directory 必须为非空字符串\")\n\n        filename, content, encoding, suffix = Cylinder2dCfdPostprocessor._read_artifact(result_file)\n        status, converged, iterations, field_statistics = Cylinder2dCfdPostprocessor._parse_result(content)\n        metrics = {\n            \"status\": status,\n            \"converged\": converged,\n            \"iterations\": iterations,\n            \"field_statistics\": field_statistics,\n        }\n        statistics_text = (\n            json.dumps(field_statistics, ensure_ascii=False, sort_keys=True)\n            if field_statistics\n            else \"无可解析的数值场统计量\"\n        )\n        report = \"\\n\".join(\n            [\n                \"CFD 结果后处理报告\",\n                f\"结果文件：{filename}\",\n                f\"编码：{encoding}\",\n                f\"工件后缀：{suffix}\",\n                f\"求解状态：{status}\",\n                f\"是否收敛：{'是' if converged else '否'}\",\n                f\"迭代次数：{iterations}\",\n                f\"场变量统计量：{statistics_text}\",\n                \"产物：cylinder2d_postprocess_report.txt、cylinder2d_postprocess_metrics.json\",\n            ]\n        )\n\n        output_root = Path(output_directory)\n        try:\n            output_root.mkdir(parents=True, exist_ok=True)\n            report_path = output_root / \"cylinder2d_postprocess_report.txt\"\n            metrics_path = output_root / \"cylinder2d_postprocess_metrics.json\"\n            with report_path.open(\"w\", encoding=\"utf-8\") as report_file:\n                report_file.write(report)\n            with metrics_path.open(\"w\", encoding=\"utf-8\") as metrics_file:\n                json.dump(metrics, metrics_file, ensure_ascii=False, sort_keys=True, indent=2)\n                metrics_file.write(\"\\n\")\n        except (OSError, TypeError, ValueError) as exc:\n            raise ValueError(f\"后处理产物写入失败: {exc}\") from exc\n\n        return {\"report\": report, \"metrics\": metrics}\n",
                "语言": "python",
                "写入模式": "create"
              },
              {
