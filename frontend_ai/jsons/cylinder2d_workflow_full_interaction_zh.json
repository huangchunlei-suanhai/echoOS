                "内容": "import json\n\nimport pytest\n\nfrom executor.cylinder2d_cfd_postprocessor import Cylinder2dCfdPostprocessor\n\n\nVALID_ARTIFACT = {\n    \"filename\": \"cylinder2d_result.cfd\",\n    \"content\": \"CYLINDER2D_CFD_RESULT_V1\\nstatus: converged\\niterations: 1200\\nvelocity_mean: 1.02\\npressure_min: -0.18\\npressure_max: 0.24\\n\",\n    \"encoding\": \"utf-8\",\n    \"suffix\": \".cfd\",\n}\n\n\ndef test_run_returns_confirmed_outputs(tmp_path) -> None:\n    result = Cylinder2dCfdPostprocessor.run(VALID_ARTIFACT, str(tmp_path))\n    assert set(result) == {\"report\", \"metrics\"}\n    assert isinstance(result[\"report\"], str)\n    assert result[\"report\"]\n    assert result[\"metrics\"][\"status\"] == \"converged\"\n    assert result[\"metrics\"][\"converged\"] is True\n    assert result[\"metrics\"][\"iterations\"] == 1200\n    assert result[\"metrics\"][\"field_statistics\"] == {\n        \"velocity_mean\": 1.02,\n        \"pressure_min\": -0.18,\n        \"pressure_max\": 0.24,\n    }\n    assert (tmp_path / \"cylinder2d_postprocess_report.txt\").read_text(encoding=\"utf-8\") == result[\"report\"]\n    saved_metrics = json.loads(\n        (tmp_path / \"cylinder2d_postprocess_metrics.json\").read_text(encoding=\"utf-8\")\n    )\n    assert saved_metrics == result[\"metrics\"]\n\n\ndef test_run_accepts_materialized_cfd_path(tmp_path) -> None:\n    input_path = tmp_path / \"materialized_result.cfd\"\n    input_path.write_text(VALID_ARTIFACT[\"content\"], encoding=\"utf-8\")\n    result = Cylinder2dCfdPostprocessor.run(str(input_path), str(tmp_path / \"output\"))\n    assert result[\"metrics\"][\"status\"] == \"converged\"\n    assert result[\"metrics\"][\"iterations\"] == 1200\n    assert \"materialized_result.cfd\" in result[\"report\"]\n\n\ndef test_not_converged_result_preserves_status_and_metrics(tmp_path) -> None:\n    artifact = {\n        **VALID_ARTIFACT,\n        \"content\": \"CYLINDER2D_CFD_RESULT_V1\\nstatus: not_converged\\niterations: 48\\nvelocity_mean: 0.91\\n\",\n    }\n    result = Cylinder2dCfdPostprocessor.run(artifact, str(tmp_path))\n    assert result[\"metrics\"][\"status\"] == \"not_converged\"\n    assert result[\"metrics\"][\"converged\"] is False\n    assert result[\"metrics\"][\"iterations\"] == 48\n    assert result[\"metrics\"][\"field_statistics\"] == {\"velocity_mean\": 0.91}\n    assert \"是否收敛：否\" in result[\"report\"]\n\n\n@pytest.mark.parametrize(\n    \"artifact\",\n    [\n        {\n            \"filename\": \"cylinder2d_result.cfd\",\n            \"content\": \"CYLINDER2D_CFD_RESULT_V1\\nstatus: converged\\n\",\n            \"encoding\": \"utf-8\",\n        },\n        {**VALID_ARTIFACT, \"filename\": \"\"},\n        {**VALID_ARTIFACT, \"encoding\": \"ascii\"},\n        {**VALID_ARTIFACT, \"suffix\": \".txt\"},\n        {**VALID_ARTIFACT, \"content\": \"\"},\n        {**VALID_ARTIFACT, \"content\": \"UNSUPPORTED_RESULT_V1\\nstatus: converged\\n\"},\n        {**VALID_ARTIFACT, \"content\": \"CYLINDER2D_CFD_RESULT_V1\\nstatus: converged\\niterations: 12.5\\n\"},\n    ],\n)\ndef test_invalid_result_artifacts_raise_value_error(tmp_path, artifact) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dCfdPostprocessor.run(artifact, str(tmp_path))\n\n\ndef test_empty_output_directory_is_rejected() -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dCfdPostprocessor.run(VALID_ARTIFACT, \"\")\n\n\ndef test_result_artifact_rejects_additional_fields(tmp_path) -> None:\n    artifact = {**VALID_ARTIFACT, \"unexpected\": True}\n    with pytest.raises(ValueError, match=\"未声明字段\"):\n        Cylinder2dCfdPostprocessor.run(artifact, str(tmp_path))\n",
