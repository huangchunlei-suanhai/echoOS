              "内容": "from pathlib import Path\n\nimport pytest\n\nfrom executor.cylinder2d_fluid_boundary_case import Cylinder2dFluidBoundaryCase\n\n\nMESH_FIXTURE = \"\"\"$MeshFormat\n2.2 0 8\n$EndMeshFormat\n$PhysicalNames\n4\n1 1 \\\"inlet\\\"\n1 2 \\\"outlet\\\"\n1 3 \\\"cylinder\\\"\n1 4 \\\"walls\\\"\n$EndPhysicalNames\n$Nodes\n4\n1 0 0 0\n2 1 0 0\n3 1 1 0\n4 0 1 0\n$EndNodes\n$Elements\n4\n1 1 2 1 1 1 2\n2 1 2 2 2 2 3\n3 1 2 3 3 3 4\n4 1 2 4 4 4 1\n$EndElements\n\"\"\"\n\n\ndef _arguments(output_directory: str) -> dict:\n    return {\n        \"inlet_velocity\": 1.0,\n        \"fluid_density\": 1000.0,\n        \"fluid_viscosity\": 0.001,\n        \"solver_mode\": \"steady\",\n        \"output_directory\": output_directory,\n    }\n\n\ndef test_run_returns_confirmed_outputs_from_materialized_mesh(tmp_path: Path) -> None:\n    mesh_path = tmp_path / \"cylinder2d.msh\"\n    mesh_path.write_text(MESH_FIXTURE, encoding=\"utf-8\")\n    arguments = _arguments(str(tmp_path / \"case\"))\n\n    result = Cylinder2dFluidBoundaryCase.run(str(mesh_path), **arguments)\n\n    assert set(result) == {\"case_definition\"}\n    case_definition = result[\"case_definition\"]\n    assert set(case_definition) == {\n        \"inlet_velocity\",\n        \"fluid_density\",\n        \"fluid_viscosity\",\n        \"solver_mode\",\n        \"boundary_regions\",\n        \"output_directory\",\n    }\n    assert case_definition[\"inlet_velocity\"] == 1.0\n    assert case_definition[\"fluid_density\"] == 1000.0\n    assert case_definition[\"fluid_viscosity\"] == 0.001\n    assert case_definition[\"solver_mode\"] == \"steady\"\n    assert case_definition[\"boundary_regions\"] == {\n        \"inlet\": \"inlet\",\n        \"outlet\": \"outlet\",\n        \"cylinder\": \"cylinder\",\n        \"walls\": \"walls\",\n    }\n    assert case_definition[\"output_directory\"] == arguments[\"output_directory\"]\n    assert (Path(arguments[\"output_directory\"]) / \"case_definition.json\").is_file()\n\n\ndef test_run_accepts_confirmed_in_memory_mesh_artifact(tmp_path: Path) -> None:\n    artifact = {\n        \"filename\": \"cylinder2d.msh\",\n        \"content\": MESH_FIXTURE,\n        \"encoding\": \"utf-8\",\n        \"suffix\": \".msh\",\n        \"artifact_contract\": {\"format\": \"cylinder2d_cfd_mesh_v1\"},\n    }\n\n    result = Cylinder2dFluidBoundaryCase.run(\n        artifact,\n        inlet_velocity=1.0,\n        fluid_density=1000.0,\n        fluid_viscosity=0.001,\n        solver_mode=\"transient\",\n        output_directory=str(tmp_path / \"transient_case\"),\n    )\n\n    assert set(result) == {\"case_definition\"}\n    assert result[\"case_definition\"][\"solver_mode\"] == \"transient\"\n    assert result[\"case_definition\"][\"boundary_regions\"][\"cylinder\"] == \"cylinder\"\n\n\n@pytest.mark.parametrize(\n    (\"field\", \"value\"),\n    [\n        (\"inlet_velocity\", 0),\n        (\"inlet_velocity\", -1),\n        (\"fluid_density\", 0),\n        (\"fluid_viscosity\", 0),\n        (\"solver_mode\", \"invalid\"),\n        (\"output_directory\", \"\"),\n    ],\n)\ndef test_run_rejects_invalid_contract_inputs(tmp_path: Path, field: str, value) -> None:\n    mesh_path = tmp_path / \"cylinder2d.msh\"\n    mesh_path.write_text(MESH_FIXTURE, encoding=\"utf-8\")\n    arguments = _arguments(str(tmp_path / \"case\"))\n    arguments[field] = value\n\n    with pytest.raises(ValueError):\n        Cylinder2dFluidBoundaryCase.run(str(mesh_path), **arguments)\n\n\ndef test_run_rejects_missing_boundary_region(tmp_path: Path) -> None:\n    mesh_path = tmp_path / \"incomplete.msh\"\n    mesh_path.write_text(MESH_FIXTURE.replace('1 4 \"walls\"', '1 4 \"farfield\"'), encoding=\"utf-8\")\n\n    with pytest.raises(ValueError, match=\"walls\"):\n        Cylinder2dFluidBoundaryCase.run(\n            str(mesh_path),\n            inlet_velocity=1.0,\n            fluid_density=1000.0,\n            fluid_viscosity=0.001,\n            solver_mode=\"steady\",\n            