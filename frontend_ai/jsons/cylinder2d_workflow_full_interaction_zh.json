                "用途": "pytest 单元测试",
                "内容": "import json\nfrom pathlib import Path\n\nimport pytest\n\nfrom executor.cylinder2d_parametric_geometry import Cylinder2dParametricGeometry\n\n\ndef valid_inputs(tmp_path: Path) -> dict:\n    return {\n        \"cylinder_diameter\": 1.0,\n        \"cylinder_x\": 2.0,\n        \"cylinder_y\": 0.0,\n        \"domain_length\": 20.0,\n        \"domain_height\": 10.0,\n        \"output_directory\": str(tmp_path),\n    }\n\n\ndef test_run_returns_confirmed_outputs(tmp_path: Path) -> None:\n    inputs = valid_inputs(tmp_path)\n    result = Cylinder2dParametricGeometry.run(**inputs)\n\n    assert set(result) == {\"geometry_file\", \"boundary_metadata\"}\n    artifact = result[\"geometry_file\"]\n    assert set(artifact) == {\"filename\", \"content\", \"encoding\", \"suffix\"}\n    assert artifact[\"filename\"] == \"cylinder2d_geometry.json\"\n    assert artifact[\"encoding\"] == \"utf-8\"\n    assert artifact[\"suffix\"] == \".json\"\n    assert isinstance(artifact[\"content\"], str)\n\n    geometry = json.loads(artifact[\"content\"])\n    assert geometry[\"format\"] == \"cylinder2d_parametric_geometry_v1\"\n    assert geometry[\"dimension\"] == 2\n    assert geometry[\"domain\"][\"bounds\"] == {\n        \"x_min\": -10.0,\n        \"x_max\": 10.0,\n        \"y_min\": -5.0,\n        \"y_max\": 5.0,\n    }\n    assert geometry[\"cylinder\"][\"center\"] == [2.0, 0.0]\n    assert geometry[\"cylinder\"][\"diameter\"] == 1.0\n    assert geometry[\"domain\"][\"fluid_area\"] == pytest.approx(\n        200.0 - pytest.approx(3.141592653589793 * 0.25)\n    )\n\n    expected_boundaries = {\"inlet\", \"outlet\", \"top\", \"bottom\", \"cylinder_wall\"}\n    assert set(result[\"boundary_metadata\"]) == expected_boundaries\n    assert set(geometry[\"boundaries\"]) == expected_boundaries\n    assert geometry[\"boundaries\"] == result[\"boundary_metadata\"]\n\n    written_path = tmp_path / \"cylinder2d_geometry.json\"\n    assert written_path.is_file()\n    assert written_path.read_text(encoding=\"utf-8\") == artifact[\"content\"]\n\n\ndef test_output_is_deterministic(tmp_path: Path) -> None:\n    first_directory = tmp_path / \"first\"\n    second_directory = tmp_path / \"second\"\n    first_inputs = valid_inputs(first_directory)\n    second_inputs = valid_inputs(second_directory)\n\n    first = Cylinder2dParametricGeometry.run(**first_inputs)\n    second = Cylinder2dParametricGeometry.run(**second_inputs)\n\n    assert first[\"geometry_file\"] == second[\"geometry_file\"]\n    assert first[\"boundary_metadata\"] == second[\"boundary_metadata\"]\n\n\n@pytest.mark.parametrize(\n    (\"field\", \"value\"),\n    [\n        (\"cylinder_diameter\", 0.0),\n        (\"cylinder_diameter\", -1.0),\n        (\"domain_length\", 0.0),\n        (\"domain_length\", -20.0),\n        (\"domain_height\", 0.0),\n        (\"domain_height\", -10.0),\n        (\"cylinder_x\", \"2.0\"),\n        (\"cylinder_y\", \"0.0\"),\n        (\"output_directory\", \"\"),\n        (\"output_directory\", 123),\n    ],\n)\ndef test_invalid_contract_inputs_raise_value_error(\n    tmp_path: Path, field: str, value: object\n) -> None:\n    inputs = valid_inputs(tmp_path)\n    inputs[field] = value\n    with pytest.raises(ValueError):\n        Cylinder2dParametricGeometry.run(**inputs)\n\n\n@pytest.mark.parametrize(\n    (\"cylinder_x\", \"cylinder_y\", \"message\"),\n    [\n        (-9.5, 0.0, \"inlet\"),\n        (9.5, 0.0, \"outlet\"),\n        (0.0, 4.5, \"top\"),\n        (0.0, -4.5, \"bottom\"),\n    ],\n)\ndef test_boundary_intersection_is_rejected(\n    tmp_path: Path, cylinder_x: float, cylinder_y: float, message: str\n) -> None:\n    inputs = valid_inputs(tmp_path)\n    inputs[\"cylinder_x\"] = cylinder_x\n    inputs[\"cylinder_y\"] = cylinder_y\n    with pytest.raises(ValueError, match=message):\n        Cylinder2dParametricGeometry.run(**inputs)\n\n\ndef test_geometry_changes_with_parameters(tmp_path: Path) -> None:\n    inputs = valid_inputs(tmp_path)\n    inputs.update(\n        cylinder_diameter=2.0,\n        cylinder_x=-1.0,\n        cylinder_y=1.0,\n        domain_length=30.0,\n        domain_height=12.0,\n    )\n    result = Cylinder2dParametricGeometry.run(**inputs)\n    geometry = json.loads(result[\"geometry_file\"][\"content\"])\n\n    assert geometry[\"domain\"][\"bounds\"] == {\n        \"x_min\": -15.0,\n        \"x_max\": 15.0,\n        \"y_min\": -6.0,\n        \"y_max\": 6.0,\n    }\n    assert geometry[\"cylinder\"][\"center\"] == [-1.0, 1.0]\n    assert geometry[\"cylinder\"][\"radius\"] == 1.0\n    assert geometry[\"boundaries\"][\"cylinder_wall\"][\"geometry\"][\"center\"] == [\n        -1.0,\n        1.0,\n    ]\n\n\ndef test_unwritable_output_directory_raises_value_error(tmp_path: Path) -> None:\n    occupied_path = tmp_path / \"occupied\"\n    occupied_path.write_text(\"not a directory\", encoding=\"utf-8\")\n    inputs = valid_inputs(occupied_path)\n\n    with pytest.raises(ValueError, match=\"failed to write geometry artifact\"):\n        Cylinder2dParametricGeometry.run(**inputs)\n",
