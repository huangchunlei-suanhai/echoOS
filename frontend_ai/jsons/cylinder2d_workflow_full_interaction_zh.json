                "路径": "executor/cylinder2d_parametric_geometry.py",
                "用途": "CGraph 节点执行入口",
                "内容": "import json\nimport math\nfrom pathlib import Path\nfrom typing import Any\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\nclass Cylinder2dParametricGeometry(ExeNodeType):\n    id = \"cylinder2d_parametric_geometry\"\n    version = \"0.1.0\"\n    source = \"cylinder2d_parametric_geometry\"\n    display_name = \"参数化二维圆柱几何生成\"\n    description = \"根据圆柱直径、位置和计算域尺寸生成二维圆柱绕流计算域几何文件，并定义入口、出口、上下边界及圆柱壁面区域。\"\n    category = \"geometry.model\"\n    receive = (FlowPort(name=\"upstream\"),)\n    send = (FlowPort(name=\"downstream\"),)\n    inputs = (\n        DataPort(\n            name=\"cylinder_diameter\",\n            dtype=\"float\",\n            display_name=\"圆柱直径\",\n            description=\"圆柱直径。\",\n            semantic_type=\"geometry.diameter\",\n            unit=\"length\",\n        ),\n        DataPort(\n            name=\"cylinder_x\",\n            dtype=\"float\",\n            display_name=\"圆柱 X 坐标\",\n            description=\"圆柱圆心 X 坐标。\",\n            semantic_type=\"geometry.point2d.x\",\n            unit=\"length\",\n        ),\n        DataPort(\n            name=\"cylinder_y\",\n            dtype=\"float\",\n            display_name=\"圆柱 Y 坐标\",\n            description=\"圆柱圆心 Y 坐标。\",\n            semantic_type=\"geometry.point2d.y\",\n            unit=\"length\",\n        ),\n        DataPort(\n            name=\"domain_length\",\n            dtype=\"float\",\n            display_name=\"计算域长度\",\n            description=\"计算域 X 方向总长度。\",\n            semantic_type=\"geometry.domain.length\",\n            unit=\"length\",\n        ),\n        DataPort(\n            name=\"domain_height\",\n            dtype=\"float\",\n            display_name=\"计算域高度\",\n            description=\"计算域 Y 方向总高度。\",\n            semantic_type=\"geometry.domain.height\",\n            unit=\"length\",\n        ),\n        DataPort(\n            name=\"output_directory\",\n            dtype=\"string\",\n            display_name=\"输出目录\",\n            description=\"用于保存参数化几何产物的目录。\",\n            semantic_type=\"filesystem.directory\",\n        ),\n    )\n    outputs = (\n        DataPort(\n            name=\"geometry_file\",\n            dtype=\"file\",\n            display_name=\"二维计算域几何\",\n            description=\"包含圆柱和外部计算域边界分区的参数化二维几何文件。\",\n            semantic_type=\"geometry.model.file\",\n            extensions={\n                \"artifact_contract\": {\n                    \"format\": \"cylinder2d_parametric_geometry_v1\"\n                }\n            },\n        ),\n        DataPort(\n            name=\"boundary_metadata\",\n            dtype=\"dict\",\n            display_name=\"边界区域元数据\",\n            description=\"几何边界名称、类型和拓扑标识。\",\n            semantic_type=\"geometry.boundary.metadata\",\n        ),\n    )\n\n    @staticmethod\n    def run(\n        cylinder_diameter,\n        cylinder_x,\n        cylinder_y,\n        domain_length,\n        domain_height,\n        output_directory,\n    ) -> dict[str, Any]:\n        numeric_inputs = {\n            \"cylinder_diameter\": cylinder_diameter,\n            \"cylinder_x\": cylinder_x,\n            \"cylinder_y\": cylinder_y,\n            \"domain_length\": domain_length,\n            \"domain_height\": domain_height,\n        }\n        for name, value in numeric_inputs.items():\n            if isinstance(value, bool) or not isinstance(value, (int, float)):\n                raise ValueError(f\"{name} dtype must be float\")\n            if not math.isfinite(float(value)):\n                raise ValueError(f\"{name} must be finite\")\n\n        if float(cylinder_diameter) <= 0.0:\n            raise ValueError(\"cylinder_diameter must be greater than zero\")\n        if float(domain_length) <= 0.0:\n            raise ValueError(\"domain_length must be greater than zero\")\n        if float(domain_height) <= 0.0:\n            raise ValueError(\"domain_height must be greater than zero\")\n        if not isinstance(output_directory, str):\n            raise ValueError(\"output_directory dtype must be string\")\n        if not output_directory.strip():\n            raise ValueError(\"output_directory must not be empty\")\n\n        diameter = float(cylinder_diameter)\n        center_x = float(cylinder_x)\n        center_y = float(cylinder_y)\n        length = float(domain_length)\n        height = float(domain_height)\n        radius = diameter / 2.0\n\n        x_min = -length / 2.0\n        x_max = length / 2.0\n        y_min = -height / 2.0\n        y_max = height / 2.0\n\n        if center_x - radius <= x_min:\n            raise ValueError(\"cylinder intersects or crosses the inlet boundary\")\n        if center_x + radius >= x_max:\n            raise ValueError(\"cylinder intersects or crosses the outlet boundary\")\n        if center_y - radius <= y_min:\n            raise ValueError(\"cylinder intersects or crosses the bottom boundary\")\n        if center_y + radius >= y_max:\n            raise ValueError(\"cylinder intersects or crosses the top boundary\")\n\n        boundaries = {\n            \"inlet\": {\n                \"name\": \"inlet\",\n                \"type\": \"velocity_inlet\",\n                \"topology_id\": \"edge:outer:left\",\n                \"geometry\": {\n                    \"kind\": \"line_segment\",\n                    \"start\": [x_min, y_min],\n                    \"end\": [x_min, y_max],\n                    \"length\": height,\n                },\n            },\n            \"outlet\": {\n                \"name\": \"outlet\",\n                \"type\": \"pressure_outlet\",\n                \"topology_id\": \"edge:outer:right\",\n                \"geometry\": {\n                    \"kind\": \"line_segment\",\n                    \"start\": [x_max, y_min],\n                    \"end\": [x_max, y_max],\n                    \"length\": height,\n                },\n            },\n            \"top\": {\n                \"name\": \"top\",\n                \"type\": \"farfield\",\n                \"topology_id\": \"edge:outer:top\",\n                \"geometry\": {\n                    \"kind\": \"line_segment\",\n                    \"start\": [x_min, y_max],\n                    \"end\": [x_max, y_max],\n                    \"length\": length,\n                },\n            },\n            \"bottom\": {\n                \"name\": \"bottom\",\n                \"type\": \"farfield\",\n                \"topology_id\": \"edge:outer:bottom\",\n                \"geometry\": {\n                    \"kind\": \"line_segment\",\n                    \"start\": [x_min, y_min],\n                    \"end\": [x_max, y_min],\n                    \"length\": length,\n                },\n            },\n            \"cylinder_wall\": {\n                \"name\": \"cylinder_wall\",\n                \"type\": \"wall\",\n                \"topology_id\": \"edge:hole:cylinder\",\n                \"geometry\": {\n                    \"kind\": \"circle\",\n                    \"center\": [center_x, center_y],\n                    \"radius\": radius,\n                    \"circumference\": math.pi * diameter,\n                },\n            },\n        }\n\n        outer_area = length * height\n        cylinder_area = math.pi * radius * radius\n        fluid_area = outer_area - cylinder_area\n        geometry = {\n            \"format\": \"cylinder2d_parametric_geometry_v1\",\n            \"dimension\": 2,\n            \"coordinate_system\": \"cartesian\",\n            \"domain\": {\n                \"kind\": \"rectangle_with_circular_hole\",\n                \"bounds\": {\n                    \"x_min\": x_min,\n                    \"x_max\": x_max,\n                    \"y_min\": y_min,\n                    \"y_max\": y_max,\n                },\n                \"length\": length,\n                \"height\": height,\n                \"outer_area\": outer_area,\n                \"fluid_area\": fluid_area,\n            },\n            \"cylinder\": {\n                \"center\": [center_x, center_y],\n                \"diameter\": diameter,\n                \"radius\": radius,\n                \"area\": cylinder_area,\n            },\n            \"boundaries\": boundaries,\n        }\n        content = json.dumps(\n            geometry,\n            ensure_ascii=False,\n            sort_keys=True,\n            separators=(\",\", \":\"),\n            allow_nan=False,\n        )\n\n        output_root = Path(output_directory)\n        try:\n            output_root.mkdir(parents=True, exist_ok=True)\n            output_path = output_root / \"cylinder2d_geometry.json\"\n            with output_path.open(mode=\"w\", encoding=\"utf-8\") as stream:\n                stream.write(content)\n        except OSError as exc:\n            raise ValueError(f\"failed to write geometry artifact: {exc}\") from exc\n\n        geometry_file = {\n            \"filename\": \"cylinder2d_geometry.json\",\n            \"content\": content,\n            \"encoding\": \"utf-8\",\n            \"suffix\": \".json\",\n        }\n        return {\n            \"geometry_file\": geometry_file,\n            \"boundary_metadata\": boundaries,\n        }\n",
                "语言": "python",
                "写入模式": "create"
              },
