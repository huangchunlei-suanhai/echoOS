              "内容": "{\n  \"extensions\": {\n    \"constraints\": {},\n    \"physics_domains\": \"cfd\",\n    \"semantic_role\": \"evaluate_cylinder2d_cfd_results\"\n  },\n  \"id\": \"cylinder2d_cfd_postprocessor\",\n  \"kind\": \"execute\",\n  \"meta\": {\n    \"category\": \"result.evaluation\",\n    \"description\": \"读取 CFD 结果文件，生成通用文本报告和结构化指标摘要，并将后处理产物保存到输出目录。\",\n    \"display_name\": \"CFD 结果后处理\",\n    \"icon\": null,\n    \"inputs\": [\n      {\n        \"default\": null,\n        \"description\": \"由 CFD 执行节点生成的结果文件。\",\n        \"display_name\": \"CFD 结果文件\",\n        \"dtype\": \"file\",\n        \"extensions\": {\n          \"artifact_contract\": {\n            \"format\": \"cylinder2d_cfd_result_v1\"\n          },\n          \"smoke_test_value\": {\n            \"content\": \"CYLINDER2D_CFD_RESULT_V1\\nstatus: converged\\n\",\n            \"encoding\": \"utf-8\",\n            \"filename\": \"cylinder2d_result.cfd\",\n            \"suffix\": \".cfd\"\n          }\n        },\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"result_file\",\n        \"semantic_type\": \"cfd.result\",\n        \"tags\": [],\n        \"unit\": null\n      },\n      {\n        \"default\": null,\n        \"description\": \"用于保存后处理报告和指标文件的目录。\",\n        \"display_name\": \"输出目录\",\n        \"dtype\": \"string\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"output_directory\",\n        \"semantic_type\": \"filesystem.directory\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"outputs\": [\n      {\n        \"default\": null,\n        \"description\": \"包含求解状态、结果摘要和可用场变量概览的纯文本报告。\",\n        \"display_name\": \"后处理报告\",\n        \"dtype\": \"text\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"report\",\n        \"semantic_type\": \"cfd.postprocess.report\",\n        \"tags\": [],\n        \"unit\": null\n      },\n      {\n        \"default\": null,\n        \"description\": \"包含收敛状态、基础统计量及可计算流动特征的结构化指标。\",\n        \"display_name\": \"后处理指标\",\n        \"dtype\": \"dict\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"metrics\",\n        \"semantic_type\": \"cfd.postprocess.metrics\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"receive\": [\n      {\n        \"description\": \"上游控制流入口。\",\n        \"display_name\": \"上游\",\n        \"name\": \"upstream\"\n      }\n    ],\n    \"send\": [\n      {\n        \"description\": \"下游控制流出口。\",\n        \"display_name\": \"下游\",\n        \"name\": \"downstream\"\n      }\n    ],\n    \"source\": \"cylinder2d_cfd_postprocessor\",\n    \"tags\": [\n      \"cfd\",\n      \"postprocessing\",\n      \"result-analysis\",\n      \"report\",\n      \"metrics\"\n    ]\n  },\n  \"runtime_hints\": {},\n  \"version\": \"0.1.0\"\n}\n",
              "语言": "json",
