imum\": null,\n        \"name\": \"output_directory\",\n        \"semantic_type\": \"filesystem.directory\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"outputs\": [\n      {\n        \"default\": null,\n        \"description\": \"带有边界分区信息的二维 CFD 计算网格。\",\n        \"display_name\": \"CFD 计算网格\",\n        \"dtype\": \"mesh\",\n        \"extensions\": {\n          \"artifact_contract\": {\n            \"format\": \"cylinder2d_cfd_mesh_v1\"\n          }\n        },\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"mesh\",\n        \"semantic_type\": \"cfd.mesh\",\n        \"tags\": [],\n        \"unit\": null\n      },\n      {\n        \"default\": null,\n        \"description\": \"网格单元数量、质量统计和边界分区检查结果。\",\n        \"display_name\": \"网格质量摘要\",\n        \"dtype\": \"dict\",\n        \"extensions\": {},\n        \"items\": [],\n        \"max_length\": null,\n        \"maximum\": null,\n        \"minimum\": null,\n        \"name\": \"mesh_quality\",\n        \"semantic_type\": \"mesh.quality.summary\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"receive\": [\n      {\n        \"description\": \"上游控制流入口。\",\n        \"display_name\": \"上游\",\n        \"name\": \"upstream\"\n      }\n    ],\n    \"send\": [\n      {\n        \"description\": \"下游控制流出口。\",\n        \"display_name\": \"下游\",\n        \"name\": \"downstream\"\n      }\n    ],\n    \"source\": \"cylinder2d_cfd_mesher\",\n    \"tags\": [\n      \"cfd\",\n      \"2d\",\n      \"mesh\",\n      \"cylinder-flow\",\n      \"boundary-layer-ready\"\n    ]\n  },\n  \"runtime_hints\": {},\n  \"version\": \"0.1.0\"\n}\n",
