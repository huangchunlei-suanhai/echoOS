              "内容": "import json\nimport math\nfrom pathlib import Path\nfrom typing import Any\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\nclass Cylinder2dCfdMesher(ExeNodeType):\n    id = 'cylinder2d_cfd_mesher'\n    version = '0.1.0'\n    source = 'cylinder2d_cfd_mesher'\n    display_name = '二维圆柱绕流网格划分'\n    description = '读取参数化二维几何并依据基础网格尺寸生成适用于 CFD 求解的计算网格，同时输出网格质量摘要。'\n    category = 'geometry.mesher'\n    receive = (FlowPort(name='upstream'),)\n    send = (FlowPort(name='downstream'),)\n    inputs = (\n        DataPort(\n            name='geometry_file',\n            dtype='file',\n            display_name='输入几何',\n            description='参数化二维圆柱绕流几何文件。',\n            semantic_type='geometry.model.file',\n            extensions={'artifact_contract': {'format': 'cylinder2d_parametric_geometry_v1'}},\n        ),\n        DataPort(\n            name='mesh_size',\n            dtype='float',\n            display_name='基础网格尺寸',\n            description='计算域基础网格尺寸。',\n            semantic_type='mesh.base_size',\n            unit='length',\n        ),\n        DataPort(\n            name='output_directory',\n            dtype='string',\n            display_name='输出目录',\n            description='用于保存网格产物的目录。',\n            semantic_type='filesystem.directory',\n        ),\n    )\n    outputs = (\n        DataPort(\n            name='mesh',\n            dtype='mesh',\n            display_name='CFD 计算网格',\n            description='带有边界分区信息的二维 CFD 计算网格。',\n            semantic_type='cfd.mesh',\n            extensions={'artifact_contract': {'format': 'cylinder2d_cfd_mesh_v1'}},\n        ),\n        DataPort(\n            name='mesh_quality',\n            dtype='dict',\n            display_name='网格质量摘要',\n            description='网格单元数量、质量统计和边界分区检查结果。',\n            semantic_type='mesh.quality.summary',\n        ),\n    )\n\n    @staticmethod\n    def _read_geometry(geometry_file: Any) -> dict[str, Any]:\n        if isinstance(geometry_file, dict):\n            expected = {'filename', 'content', 'encoding', 'suffix'}\n            if set(geometry_file) != expected:\n                raise ValueError('geometry_file must contain exactly filename, content, encoding and suffix')\n            for field in expected:\n                if not isinstance(geometry_file[field], str) or not geometry_file[field]:\n                    raise ValueError(f'geometry_file.{field} must be a non-empty string')\n            if geometry_file['suffix'].lower() != '.json':\n                raise ValueError('geometry_file suffix must be .json')\n            if geometry_file['encoding'].lower() != 'utf-8':\n                raise ValueError('geometry_file encoding must be utf-8')\n            text = geometry_file['content']\n        elif isinstance(geometry_file, str) and geometry_file:\n            geometry_path = Path(geometry_file)\n            try:\n                with geometry_path.open('r', encoding='utf-8') as geometry_stream:\n                    text = geometry_stream.read()\n            except OSError as exc:\n                raise ValueError(f'cannot read geometry_file: {exc}') from exc\n        else:\n            raise ValueError('geometry_file must be an artifact object or a non-empty path string')\n        try:\n            geometry = json.loads(text)\n        except (TypeError, json.JSONDecodeError) as exc:\n            raise ValueError(f'geometry_file content is not valid JSON: {exc}') from exc\n        if not isinstance(geometry, dict):\n            raise ValueError('geometry_file JSON root must be an object')\n        if geometry.get('format') != 'cylinder2d_parametric_geometry_v1':\n            raise ValueError('geometry_file format is not cylinder2d_parametric_geometry_v1')\n        if geometry.get('dimension') != 2:\n            raise ValueError('geometry_file dimension must be 2')\n        return geometry\n\n    @staticmethod\n    def _finite_number(value: Any, name: str, default: float) -> float:\n        if value is None:\n            return default\n        if isinstance(value, bool) or not isinstance(value, (int, float)):\n            raise ValueError(f'{name} must be numeric')\n        converted = float(value)\n        if not math.isfinite(converted) or converted <= 0.0:\n            raise ValueError(f'{name} must be finite and positive')\n        return converted\n\n    @staticmethod\n    def _geometry_parameters(geometry: dict[str, Any], mesh_size: float) -> tuple[float, float, float, float, float]:\n        cylinder = geometry.get('cylinder')\n        if cylinder is not None and not isinstance(cylinder, dict):\n            raise ValueError('geometry.cylinder must be an object')\n        cylinder = cylinder or {}\n        radius = Cylinder2dCfdMesher._finite_number(\n            cylinder.get('radius', geometry.get('cylinder_radius', geometry.get('radius'))),\n            'cylinder radius',\n            0.5,\n        )\n        center = cylinder.get('center', geometry.get('cylinder_center', [0.0, 0.0]))\n        if not isinstance(center, (list, tuple)) or len(center) != 2:\n            raise ValueError('cylinder center must contain two coordinates')\n        if any(isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(float(value)) for value in center):\n            raise ValueError('cylinder center coordinates must be finite numbers')\n        cx, cy = float(center[0]), float(center[1])\n        domain_radius = geometry.get('domain_radius', geometry.get('outer_radius'))\n        outer_radius = Cylinder2dCfdMesher._finite_number(domain_radius, 'domain radius', 5.0 * radius)\n        if outer_radius <= radius:\n            raise ValueError('domain radius must be greater than cylinder radius')\n        radial_count = max(2, min(64, int(math.ceil((outer_radius - radius) / mesh_size))))\n        tangential_count = max(16, min(256, int(math.ceil(2.0 * math.pi * radius / mesh_size))))\n        return cx, cy, radius, outer_radius, float(radial_count), float(tangential_count)\n\n    @staticmethod\n    def run(geometry_file, mesh_size, output_directory) -> dict[str, Any]:\n        if isinstance(mesh_size, bool) or not isinstance(mesh_size, (int, float)):\n            raise ValueError('mesh_size must be a number')\n        mesh_size = float(mesh_size)\n        if not math.isfinite(mesh_size) or mesh_size < 1e-12:\n            raise ValueError('mesh_size must be finite and greater than or equal to 1e-12')\n        if not isinstance(output_directory, str) or not output_directory.strip():\n            raise ValueError('output_directory must be a non-empty string')\n\n        geometry = Cylinder2dCfdMesher._read_geometry(geometry_file)\n        cx, cy, radius, outer_radius, radial_value, tangential_value = Cylinder2dCfdMesher._geometry_parameters(geometry, mesh_size)\n        radial_count = int(radial_value)\n        tangential_count = int(tangential_value)\n\n        vertices: list[tuple[float, float]] = []\n        for radial_index in range(radial_count + 1):\n            current_radius = radius + (outer_radius - radius) * radial_index / radial_count\n            for angular_index in range(tangential_count):\n                angle = 2.0 * math.pi * angular_index / tangential_count\n                vertices.append((cx + current_radius * math.cos(angle), cy + current_radius * math.sin(angle)))\n\n        cells: list[tuple[int, int, int, int]] = []\n        for radial_index in range(radial_count):\n            inner_start = radial_index * tangential_count\n            outer_start = (radial_index + 1) * tangential_count\n            for angular_index in range(tangential_count):\n                next_angle = (angular_index + 1) % tangential_count\n                cells.append((inner_start + angular_index + 1, inner_start + next_angle + 1, outer_start + next_angle + 1, outer_start + angular_index + 1))\n\n        lines: list[str] = ['$MeshFormat', '2.2 0 8', '$EndMeshFormat', '$PhysicalNames', '2', '1 1 \"cylinder_wall\"', '2 2 \"farfield\"', '$EndPhysicalNames', '$Nodes', str(len(vertices))]\n        lines.extend(f'{index} {x:.16g} {y:.16g} 0' for index, (x, y) in enumerate(vertices, 1))\n        lines.extend(['$EndNodes', '$Elements', str(len(cells) + 2 * tangential_count)])\n        element_id = 1\n        for cell in cells:\n            lines.append(f'{element_id} 3 2 0 0 {cell[0]} {cell[1]} {cell[2]} {cell[3]}')\n            element_id += 1\n        inner_start = 1\n        outer_start = radial_count * tangential_count + 1\n        for angular_index in range(tangential_count):\n            next_angle = (angular_index + 1) % tangential_count\n            lines.append(f'{element_id} 1 2 1 1 {inner_start + next_angle} {inner_start + angular_index}')\n            element_id += 1\n        for angular_index in range(tangential_count):\n            next_angle = (angular_index + 1) % tangential_count\n            lines.append(f'{element_id} 1 2 2 2 {outer_start + angular_index} {outer_start + next_angle}')\n            element_id += 1\n        lines.append('$EndElements')\n        mesh_text = '\\n'.join(lines) + '\\n'\n\n        areas: list[float] = []\n        aspect_ratios: list[float] = []\n        for cell in cells:\n            points = [vertices[index - 1] for index in cell]\n            area = 0.5 * abs(sum(points[index][0] * points[(index + 1) % 4][1] - points[(index + 1) % 4][0] * points[index][1] for index in range(4)))\n            lengths = [math.hypot(points[index][0] - points[(index + 1) % 4][0], points[index][1] - points[(index + 1) % 4][1]) for index in range(4)]\n            if area <= 0.0 or min(lengths) <= 0.0:\n                raise ValueError('generated mesh contains a degenerate cell')\n            areas.append(area)\n            aspect_ratios.append(max(lengths) / min(lengths))\n\n        output_root = Path(output_directory)\n        try:\n            output_root.mkdir(parents=True, exist_ok=True)\n            mesh_path = output_root / 'cylinder2d.msh'\n            with mesh_path.open('w', encoding='utf-8', newline='\\n') as mesh_stream:\n                mesh_stream.write(mesh_text)\n        except OSError as exc:\n            raise ValueError(f'cannot write mesh output: {exc}') from exc\n        if not mesh_path.is_file() or mesh_path.stat().st_size == 0:\n            raise ValueError('mesh output was not written')\n\n        quality = {\n            'format': 'cylinder2d_cfd_mesh_v1',\n            'cell_count': len(cells),\n            'vertex_count': len(vertices),\n            'quality_statistics': {\n                'minimum_cell_area': min(areas),\n                'maximum_cell_area': max(areas),\n                'minimum_area': min(areas),\n                'maximum_area': max(areas),\n                'maximum_aspect_ratio': max(aspect_ratios),\n            },\n            'boundary_partition_check': {\n                'required': ['cylinder_wall', 'farfield'],\n                'present': ['cylinder_wall', 'farfield'],\n                'valid': True,\n            },\n            'mesh_parameters': {\n                'base_mesh_size': mesh_size,\n                'radial_divisions': radial_count,\n                'tangential_divisions': tangential_count,\n            },\n        }\n        return {'mesh': str(mesh_path), 'mesh_quality': quality}\n",
