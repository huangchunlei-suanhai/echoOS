                "用途": "pytest 单元测试",
                "内容": "import json\n\nimport pytest\n\nfrom executor.cylinder2d_cfd_mesher import Cylinder2dCfdMesher\n\n\nGEOMETRY_ARTIFACT = {\n    'filename': 'cylinder2d_geometry.json',\n    'content': '{\"format\":\"cylinder2d_parametric_geometry_v1\",\"dimension\":2}',\n    'encoding': 'utf-8',\n    'suffix': '.json',\n}\n\n\ndef test_run_returns_confirmed_outputs(tmp_path) -> None:\n    result = Cylinder2dCfdMesher.run(GEOMETRY_ARTIFACT, 0.01, str(tmp_path))\n    assert set(result) == {'mesh', 'mesh_quality'}\n    assert isinstance(result['mesh'], str)\n    assert result['mesh']\n    mesh_path = tmp_path / 'cylinder2d.msh'\n    assert result['mesh'] == str(mesh_path)\n    assert mesh_path.is_file()\n    assert mesh_path.stat().st_size > 0\n    assert result['mesh_quality']['format'] == 'cylinder2d_cfd_mesh_v1'\n    assert result['mesh_quality']['cell_count'] > 0\n    assert result['mesh_quality']['vertex_count'] > 0\n    assert result['mesh_quality']['quality_statistics']['minimum_cell_area'] > 0.0\n    assert result['mesh_quality']['boundary_partition_check']['valid'] is True\n    mesh_text = mesh_path.read_text(encoding='utf-8')\n    assert 'cylinder_wall' in mesh_text\n    assert 'farfield' in mesh_text\n\n\ndef test_run_accepts_materialized_geometry_path(tmp_path) -> None:\n    geometry_path = tmp_path / 'cylinder2d_geometry.json'\n    geometry_path.write_text(json.dumps({'format': 'cylinder2d_parametric_geometry_v1', 'dimension': 2}), encoding='utf-8')\n    output_directory = tmp_path / 'mesh'\n    result = Cylinder2dCfdMesher.run(str(geometry_path), 0.02, str(output_directory))\n    assert set(result) == {'mesh', 'mesh_quality'}\n    assert (output_directory / 'cylinder2d.msh').is_file()\n    assert result['mesh_quality']['mesh_parameters']['base_mesh_size'] == 0.02\n\n\n@pytest.mark.parametrize(\n    'geometry_file',\n    [\n        {'filename': 'cylinder2d_geometry.json', 'content': '{}', 'encoding': 'utf-8'},\n        {'filename': 'cylinder2d_geometry.json', 'content': {'format': 'cylinder2d_parametric_geometry_v1'}, 'encoding': 'utf-8', 'suffix': '.json'},\n        {'filename': 'cylinder2d_geometry.json', 'content': '{\"format\":\"other\",\"dimension\":2}', 'encoding': 'utf-8', 'suffix': '.json'},\n        {'filename': 'cylinder2d_geometry.json', 'content': '{\"format\":\"cylinder2d_parametric_geometry_v1\",\"dimension\":3}', 'encoding': 'utf-8', 'suffix': '.json'},\n    ],\n)\ndef test_invalid_geometry_artifacts_raise_value_error(geometry_file) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dCfdMesher.run(geometry_file, 0.01, '/tmp/cylinder2d-test')\n\n\n@pytest.mark.parametrize('mesh_size', [0, -0.01, '0.01'])\ndef test_invalid_mesh_size_raises_value_error(mesh_size) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dCfdMesher.run(GEOMETRY_ARTIFACT, mesh_size, '/tmp/cylinder2d-test')\n\n\n@pytest.mark.parametrize('output_directory', ['', 123])\ndef test_invalid_output_directory_raises_value_error(output_directory) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dCfdMesher.run(GEOMETRY_ARTIFACT, 0.01, output_directory)\n",
