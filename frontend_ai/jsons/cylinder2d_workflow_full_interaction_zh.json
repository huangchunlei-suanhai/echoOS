              "路径": "tests/test_cylinder2d_cfd_execution.py",
              "用途": "pytest 单元测试",
              "内容": "import json\n\nimport pytest\n\nfrom executor.cylinder2d_cfd_execution import Cylinder2dCfdExecution\n\n\nMESH_CONTENT = \"\"\"$MeshFormat\n2.2 0 8\n$EndMeshFormat\n$Nodes\n3\n1 0.0 0.0 0.0\n2 1.0 0.0 0.0\n3 0.0 1.0 0.0\n$EndNodes\n$Elements\n1\n1 2 2 1 1 1 2 3\n$EndElements\n\"\"\"\n\n\ndef solver_input() -> dict[str, str]:\n    return {\n        \"filename\": \"solver_input.json\",\n        \"content\": json.dumps(\n            {\n                \"case_type\": \"cylinder2d_external_flow\",\n                \"solver_mode\": \"steady\",\n                \"mesh_file\": \"mesh.msh\",\n            },\n            separators=(\",\", \":\"),\n        ),\n        \"encoding\": \"utf-8\",\n        \"suffix\": \".json\",\n    }\n\n\ndef mesh_artifact() -> dict[str, str]:\n    return {\n        \"filename\": \"cylinder2d.msh\",\n        \"content\": MESH_CONTENT,\n        \"encoding\": \"utf-8\",\n        \"suffix\": \".msh\",\n    }\n\n\ndef test_run_returns_confirmed_outputs(tmp_path) -> None:\n    mesh_path = tmp_path / \"cylinder2d.msh\"\n    mesh_path.write_text(MESH_CONTENT, encoding=\"utf-8\")\n\n    result = Cylinder2dCfdExecution.run(\n        str(mesh_path), solver_input(), str(tmp_path / \"results\")\n    )\n\n    assert set(result) == {\"result_file\", \"solver_log\"}\n    artifact = result[\"result_file\"]\n    assert set(artifact) == {\"filename\", \"content\", \"encoding\", \"suffix\"}\n    assert artifact[\"filename\"] == \"cylinder2d_result.cfd\"\n    assert artifact[\"encoding\"] == \"utf-8\"\n    assert artifact[\"suffix\"] == \".cfd\"\n    assert artifact[\"content\"].startswith(\"CYLINDER2D_CFD_RESULT_V1\\n\")\n    assert \"status: completed\" in artifact[\"content\"]\n    assert \"mesh_nodes: 3\" in artifact[\"content\"]\n    assert \"mesh_elements: 1\" in artifact[\"content\"]\n    assert \"solver_input.json\" in result[\"solver_log\"]\n    assert \"solver_mode: steady\" in result[\"solver_log\"]\n    assert str(tmp_path / \"results\") in result[\"solver_log\"]\n    assert \"execution_status: completed\" in result[\"solver_log\"]\n    assert (tmp_path / \"results\" / \"cylinder2d_result.cfd\").read_text(encoding=\"utf-8\") == artifact[\"content\"]\n    assert (tmp_path / \"results\" / \"cylinder2d_solver.log\").read_text(encoding=\"utf-8\") == result[\"solver_log\"]\n\n\ndef test_run_accepts_in_memory_mesh_artifact(tmp_path) -> None:\n    result = Cylinder2dCfdExecution.run(\n        mesh_artifact(), solver_input(), str(tmp_path / \"results\")\n    )\n\n    assert result[\"result_file\"][\"filename\"] == \"cylinder2d_result.cfd\"\n    assert \"mesh_nodes: 3\" in result[\"result_file\"][\"content\"]\n    assert \"execution_mode: validated_case_generation\" in result[\"result_file\"][\"content\"]\n    assert \"solver_status: unavailable\" in result[\"result_file\"][\"content\"]\n\n\ndef test_transient_mode_is_recorded(tmp_path) -> None:\n    payload = solver_input()\n    payload[\"content\"] = json.dumps(\n        {\n            \"case_type\": \"cylinder2d_external_flow\",\n            \"solver_mode\": \"transient\",\n            \"mesh_file\": \"mesh.msh\",\n        },\n        separators=(\",\", \":\"),\n    )\n\n    result = Cylinder2dCfdExecution.run(\n        mesh_artifact(), payload, str(tmp_path / \"results\")\n    )\n\n    assert \"solver_mode: transient\" in result[\"solver_log\"]\n    assert \"solver_mode: transient\" in result[\"result_file\"][\"content\"]\n\n\n@pytest.mark.parametrize(\n    (\"mesh\", \"solver_payload\", \"output_directory\", \"message\"),\n    [\n        (\"\", solver_input(), \"results\", \"mesh\"),\n        (123, solver_input(), \"results\", \"mesh\"),\n        (mesh_artifact(), {\"filename\": \"solver_input.json\", \"content\": \"{}\", \"suffix\": \".json\"}, \"results\", \"encoding\"),\n        (mesh_artifact(), {\"filename\": \"solver_input.json\", \"content\": {}, \"encoding\": \"utf-8\", \"suffix\": \".json\"}, \"results\", \"content\"),\n        (mesh_artifact(), {\"filename\": \"solver_input.txt\", \"content\": \"{}\", \"encoding\": \"utf-8\", \"suffix\": \".txt\"}, \"results\", \"suffix\"),\n        (mesh_artifact(), {\"filename\": \"solver_input.json\", \"content\": \"not-json\", \"encoding\": \"utf-8\", \"suffix\": \".json\"}, \"results\", \"invalid JSON\"),\n        (mesh_artifact(), solver_input(), \"\", \"output_directory\"),\n        (mesh_artifact(), solver_input(), 123, \"output_directory\"),\n    ],\n)\ndef test_invalid_contract_inputs_raise_value_error(\n    mesh, solver_payload, output_directory, message\n) -> None:\n    with pytest.raises(ValueError, match=message):\n        Cylinder2dCfdExecution.run(mesh, solver_payload, output_directory)\n",
