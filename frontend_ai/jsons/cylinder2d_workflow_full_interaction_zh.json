 \"minimum\": null,\n        \"name\": \"boundary_metadata\",\n        \"semantic_type\": \"geometry.boundary.metadata\",\n        \"tags\": [],\n        \"unit\": null\n      }\n    ],\n    \"receive\": [\n      {\n        \"description\": \"上游控制流入口。\",\n        \"display_name\": \"上游\",\n        \"name\": \"upstream\"\n      }\n    ],\n    \"send\": [\n      {\n        \"description\": \"下游控制流出口。\",\n        \"display_name\": \"下游\",\n        \"name\": \"downstream\"\n      }\n    ],\n    \"source\": \"cylinder2d_parametric_geometry\",\n    \"tags\": [\n      \"cfd\",\n      \"2d\",\n      \"cylinder-flow\",\n      \"parametric-geometry\",\n      \"domain-generation\"\n    ]\n  },\n  \"runtime_hints\": {},\n  \"version\": \"0.1.0\"\n}\n",
