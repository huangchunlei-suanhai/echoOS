                "用途": "CGraph 节点执行入口",
                "内容": "from __future__ import annotations\n\nimport json\nimport math\nimport re\nfrom pathlib import Path\nfrom typing import Any, Mapping\n\nfrom cgraph.library import DataPort, ExeNodeType, FlowPort\n\n\n_REQUIRED_BOUNDARIES = (\"inlet\", \"outlet\", \"cylinder\", \"walls\")\n\n\nclass Cylinder2dFluidBoundaryCase(ExeNodeType):\n    id = \"cylinder2d_fluid_boundary_case\"\n    version = \"0.1.0\"\n    source = \"cylinder2d_fluid_boundary_case\"\n    display_name = \"流体物性与边界条件设置\"\n    description = \"根据来流速度、流体密度、动力黏度和求解模式生成二维圆柱绕流 CFD 工况定义，包括流体物性、入口速度、出口条件、壁面条件和求解模式。\"\n    category = \"condition.case\"\n    receive = (FlowPort(name=\"upstream\"),)\n    send = (FlowPort(name=\"downstream\"),)\n    inputs = (\n        DataPort(\n            name=\"mesh\",\n            dtype=\"mesh\",\n            display_name=\"计算网格\",\n            description=\"用于绑定边界区域和检查网格边界命名的二维 CFD 网格。\",\n            semantic_type=\"cfd.mesh\",\n            extensions={\"artifact_contract\": {\"format\": \"cylinder2d_cfd_mesh_v1\"}},\n        ),\n        DataPort(\n            name=\"inlet_velocity\",\n            dtype=\"float\",\n            display_name=\"入口来流速度\",\n            description=\"入口均匀来流速度。\",\n            semantic_type=\"fluid.inlet_velocity\",\n            unit=\"velocity\",\n        ),\n        DataPort(\n            name=\"fluid_density\",\n            dtype=\"float\",\n            display_name=\"流体密度\",\n            description=\"不可压流体密度。\",\n            semantic_type=\"fluid.density\",\n            unit=\"mass_per_volume\",\n        ),\n        DataPort(\n            name=\"fluid_viscosity\",\n            dtype=\"float\",\n            display_name=\"动力黏度\",\n            description=\"不可压流体动力黏度。\",\n            semantic_type=\"fluid.dynamic_viscosity\",\n            unit=\"dynamic_viscosity\",\n        ),\n        DataPort(\n            name=\"solver_mode\",\n            dtype=\"menu\",\n            display_name=\"求解模式\",\n            description=\"稳态或瞬态求解模式。\",\n            items=[\"steady\", \"transient\"],\n            semantic_type=\"solver.mode\",\n        ),\n        DataPort(\n            name=\"output_directory\",\n            dtype=\"string\",\n            display_name=\"输出目录\",\n            description=\"用于保存工况定义的目录。\",\n            semantic_type=\"filesystem.directory\",\n        ),\n    )\n    outputs = (\n        DataPort(\n            name=\"case_definition\",\n            dtype=\"dict\",\n            display_name=\"CFD 工况定义\",\n            description=\"包含流体物性、边界条件、求解模式和边界区域映射的结构化工况定义。\",\n            semantic_type=\"cfd.case.definition\",\n        ),\n    )\n\n    @staticmethod\n    def _read_mesh(mesh: Any) -> str:\n        if isinstance(mesh, Mapping):\n            content = mesh.get(\"content\")\n            if not isinstance(content, str) or not content:\n                raise ValueError(\"mesh 内存产物必须包含非空 UTF-8 content\")\n            encoding = mesh.get(\"encoding\", \"utf-8\")\n            if encoding != \"utf-8\":\n                raise ValueError(\"mesh 内存产物 encoding 必须为 utf-8\")\n            contract = mesh.get(\"artifact_contract\")\n            if contract is not None and contract != {\"format\": \"cylinder2d_cfd_mesh_v1\"}:\n                raise ValueError(\"mesh artifact_contract 与已确认产物契约不一致\")\n            return content\n        if not isinstance(mesh, str) or not mesh.strip():\n            raise ValueError(\"mesh 必须是非空受控文件路径或内存产物包\")\n        mesh_path = Path(mesh)\n        if not mesh_path.is_file():\n            raise ValueError(f\"mesh 文件不可读取: {mesh}\")\n        try:\n            return mesh_path.read_text(encoding=\"utf-8\")\n        except (OSError, UnicodeError) as exc:\n            raise ValueError(f\"mesh 文件读取失败: {mesh}\") from exc\n\n    @staticmethod\n    def _boundary_regions(mesh_text: str) -> dict[str, str]:\n        physical_start = mesh_text.find(\"$PhysicalNames\")\n        physical_end = mesh_text.find(\"$EndPhysicalNames\", physical_start)\n        elements_start = mesh_text.find(\"$Elements\")\n        elements_end = mesh_text.find(\"$EndElements\", elements_start)\n        if min(physical_start, physical_end, elements_start, elements_end) < 0:\n            raise ValueError(\"mesh 必须包含可解析的 Gmsh ASCII PhysicalNames 和 Elements 区段\")\n\n        physical_lines = mesh_text[physical_start + len(\"$PhysicalNames\") : physical_end].splitlines()\n        physical_names: dict[int, str] = {}\n        for line in physical_lines[1:]:\n            match = re.match(r\"^\\s*\\d+\\s+(\\d+)\\s+\\\"([^\\\"]+)\\\"\\s*$\", line)\n            if match:\n                physical_names[int(match.group(1))] = match.group(2).strip()\n\n        found: dict[str, str] = {}\n        element_lines = mesh_text[elements_start + len(\"$Elements\") : elements_end].splitlines()\n        for line in element_lines[1:]:\n            fields = line.split()\n            if len(fields) < 5:\n                continue\n            try:\n                element_type = int(fields[1])\n                tag_count = int(fields[2])\n            except ValueError:\n                continue\n            if element_type not in (1, 8) or len(fields) <= 3 + tag_count:\n                continue\n            try:\n                physical_id = int(fields[3])\n            except ValueError:\n                continue\n            boundary_name = physical_names.get(physical_id, \"\")\n            if boundary_name in _REQUIRED_BOUNDARIES:\n                found[boundary_name] = boundary_name\n\n        missing = [name for name in _REQUIRED_BOUNDARIES if name not in found]\n        if missing:\n            raise ValueError(\"mesh 缺少必需边界区域: \" + \", \".join(missing))\n        return {name: found[name] for name in _REQUIRED_BOUNDARIES}\n\n    @staticmethod\n    def run(mesh, inlet_velocity, fluid_density, fluid_viscosity, solver_mode, output_directory) -> dict[str, Any]:\n        numeric_inputs = (\n            (\"inlet_velocity\", inlet_velocity, 1e-6),\n            (\"fluid_density\", fluid_density, 1e-6),\n            (\"fluid_viscosity\", fluid_viscosity, 1e-12),\n        )\n        for name, value, minimum in numeric_inputs:\n            if isinstance(value, bool) or not isinstance(value, (int, float)):\n                raise ValueError(f\"{name} 必须是数值\")\n            if not math.isfinite(float(value)) or float(value) < minimum:\n                raise ValueError(f\"{name} 必须不小于 {minimum}\")\n\n        if not isinstance(solver_mode, str) or solver_mode not in (\"steady\", \"transient\"):\n            raise ValueError(\"solver_mode 只能是 steady 或 transient\")\n        if not isinstance(output_directory, str) or not output_directory.strip():\n            raise ValueError(\"output_directory 必须是非空字符串\")\n\n        mesh_text = Cylinder2dFluidBoundaryCase._read_mesh(mesh)\n        boundary_regions = Cylinder2dFluidBoundaryCase._boundary_regions(mesh_text)\n        output_root = Path(output_directory)\n        try:\n            output_root.mkdir(parents=True, exist_ok=True)\n            definition_path = output_root / \"case_definition.json\"\n            case_definition = {\n                \"inlet_velocity\": inlet_velocity,\n                \"fluid_density\": fluid_density,\n                \"fluid_viscosity\": fluid_viscosity,\n                \"solver_mode\": solver_mode,\n                \"boundary_regions\": boundary_regions,\n                \"output_directory\": output_directory,\n            }\n            with definition_path.open(\"w\", encoding=\"utf-8\") as stream:\n                json.dump(case_definition, stream, ensure_ascii=False, indent=2, sort_keys=True)\n                stream.write(\"\\n\")\n        except OSError as exc:\n            raise ValueError(f\"output_directory 不可写: {output_directory}\") from exc\n\n        return {\"case_definition\": case_definition}\n",
                "语言": "python",
                "写入模式": "create"
