              "用途": "pytest 单元测试",
              "内容": "import json\n\nimport pytest\n\nfrom executor.cylinder2d_solver_input_generator import Cylinder2dSolverInputGenerator\n\n\nMESH_CONTENT = \"\"\"$MeshFormat\n2.2 0 8\n$EndMeshFormat\n$Nodes\n4\n1 0 0 0\n2 1 0 0\n3 1 1 0\n4 0 1 0\n$EndNodes\n$Elements\n2\n1 2 2 1 1 1 2 3\n2 2 2 1 1 1 3 4\n$EndElements\n\"\"\"\n\nCASE = {\n    \"inlet_velocity\": 1,\n    \"fluid_density\": 1000,\n    \"fluid_viscosity\": 0.001,\n    \"solver_mode\": \"steady\",\n    \"boundary_regions\": {\n        \"inlet\": \"inlet\",\n        \"outlet\": \"outlet\",\n        \"cylinder\": \"cylinder\",\n        \"walls\": \"walls\",\n    },\n    \"output_directory\": \"/tmp/cylinder2d_case\",\n}\n\n\ndef mesh_artifact():\n    return {\n        \"filename\": \"cylinder2d.msh\",\n        \"content\": MESH_CONTENT,\n        \"encoding\": \"utf-8\",\n        \"suffix\": \".msh\",\n    }\n\n\ndef test_run_returns_confirmed_outputs_and_writes_json(tmp_path) -> None:\n    result = Cylinder2dSolverInputGenerator.run(mesh_artifact(), CASE, str(tmp_path))\n    assert set(result) == {\"solver_input_file\"}\n    artifact = result[\"solver_input_file\"]\n    assert artifact[\"filename\"] == \"solver_input.json\"\n    assert artifact[\"encoding\"] == \"utf-8\"\n    assert artifact[\"suffix\"] == \".json\"\n    document = json.loads(artifact[\"content\"])\n    assert document[\"case_type\"] == \"cylinder2d_external_flow\"\n    assert document[\"solver_mode\"] == \"steady\"\n    assert document[\"mesh_statistics\"][\"node_count\"] == 4\n    assert document[\"mesh_statistics\"][\"element_count\"] == 2\n    assert (tmp_path / \"solver_input.json\").read_text(encoding=\"utf-8\") == artifact[\"content\"]\n\n\ndef test_run_accepts_materialized_mesh_path(tmp_path) -> None:\n    mesh_path = tmp_path / \"cylinder2d.msh\"\n    mesh_path.write_text(MESH_CONTENT, encoding=\"utf-8\")\n    result = Cylinder2dSolverInputGenerator.run(str(mesh_path), CASE, str(tmp_path / \"out\"))\n    document = json.loads(result[\"solver_input_file\"][\"content\"])\n    assert document[\"mesh_file\"] == \"cylinder2d.msh\"\n    assert document[\"mesh_statistics\"][\"format\"] == \"gmsh_ascii\"\n\n\n@pytest.mark.parametrize(\n    \"case\",\n    [\n        {key: value for key, value in CASE.items() if key != \"fluid_viscosity\"},\n        {**CASE, \"inlet_velocity\": 0},\n        {**CASE, \"solver_mode\": \"invalid\"},\n    ],\n)\ndef test_invalid_case_definitions_raise_value_error(case) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dSolverInputGenerator.run(mesh_artifact(), case, \"/tmp/cylinder2d_test\")\n\n\n@pytest.mark.parametrize(\"mesh\", [\"\", 123, {\"filename\": \"mesh.msh\"}])\ndef test_invalid_mesh_inputs_raise_value_error(mesh) -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dSolverInputGenerator.run(mesh, CASE, \"/tmp/cylinder2d_test\")\n\n\ndef test_invalid_output_directory_raises_value_error() -> None:\n    with pytest.raises(ValueError):\n        Cylinder2dSolverInputGenerator.run(mesh_artifact(), CASE, \"\")\n",
