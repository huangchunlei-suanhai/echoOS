c\n            if not content:\n                raise ValueError('geometry_file content must not be empty')\n            return path.name, content\n\n        if not isinstance(geometry_file, Mapping):\n            raise ValueError('geometry_file must be a controlled path or an in-memory STL artifact')\n\n        required_fields = {'filename', 'content', 'encoding', 'suffix'}\n        allowed_fields = required_fields | {'artifact_contract'}\n        missing_fields = required_fields - set(geometry_file)\n        unknown_fields = set(geometry_file) - allowed_fields\n        if missing_fields:\n            raise ValueError(f'geometry_file artifact is missing fields: {sorted(missing_fields)}')\n        if unknown_fields:\n            raise ValueError(f'geometry_file artifact contains unsupported fields: {sorted(unknown_fields)}')\n\n        filename = geometry_file['filename']\n        content = geometry_file['content']\n        encoding = geometry_file['encoding']\n        suffix = geometry_file['suffix']\n        if not isinstance(filename, str) or not filename.strip():\n            raise ValueError('geometry_file.filename must be a non-empty string')\n        if not isinstance(content, str) or not content:\n            raise ValueError('geometry_file.content must be a non-empty string')\n        if encoding != 'ascii':\n            raise ValueError('geometry_file.encoding must be ascii')\n        if suffix != '.stl':\n            raise ValueError('geometry_file.suffix must be .stl')\n        if not filename.lower().endswith('.stl'):\n            raise ValueError('geometry_file.filename must identify an STL file')\n        if 'artifact_contract' in geometry_file:\n            artifact_contract = geometry_file['artifact_contract']\n            if not isinstance(artifact_contract, Mapping):\n                raise ValueError('geometry_file.artifact_contract must be an object')\n            if artifact_contract.get('format') != 'stl_surface_mesh':\n                raise ValueError('geometry_file artifact format must be stl_surface_mesh')\n        try:\n            content.encode('ascii')\n        except UnicodeEncodeError as exc:\n            raise ValueError('geometry_file.content must be ASCII text') from exc\n        return filename, content\n\n    @staticmethod\n    def _validate_ascii_stl(content: str) -> None:\n        lines = content.splitlines()\n        if not lines:\n            raise ValueError('STL content is empty')\n\n        first_index = next((index for index, line in enumerate(lines) if line.strip()), None)\n        if first_index is None:\n            raise ValueError('STL content contains no records')\n        first_tokens = lines[first_index].strip().split()\n        if not first_tokens or first_tokens[0].lower() != 'solid':\n            raise ValueError('ASCII STL must start with a solid record')\n\n        state = 'await_facet'\n        facet_count = 0\n        current_vertices: list[tuple[float, float, float]] = []\n        all_vertices: list[tuple[float, float, float]] = []\n        normals: list[tuple[float, float, float]] = []\n\n        for line_number, raw_line in enumerate(lines[first_index + 1:], start=first_index + 2):\n            stripped = raw_line.strip()\n            if not stripped:\n                continue\n            tokens = stripped.split()\n            keyword = tokens[0].lower()\n\n            if state == 'await_facet':\n                if keyword == 'facet':\n                    if len(tokens) != 5 or tokens[1].lower() != 'normal':\n                        raise ValueError(f'invalid facet normal at STL line {line_number}')\n                    try:\n                        normal = tuple(float(value) for value in tokens[2:5])\n                    except ValueError as exc:\n                        raise ValueError(f'non-numeric facet normal at STL line {line_number}') from exc\n                    normal_array = np.asarray(normal, dtype=np.float64)\n                    if not np.isfinite(normal_array).all():\n                        raise ValueError(f'non-finite facet normal at STL line {line_number}')\n                    normals.append(normal)\n                    current_vertices = []\n                    state = 'await_outer_loop'\n                elif keyword == 'endsolid' and facet_count > 0:\n                    state = 'done'\n                else:\n                    raise ValueError(f'expected facet or endsolid at STL line {line_number}')\n                continue\n\n            if state == 'await_outer_loop':\n                if tokens != ['outer', 'loop']:\n                    raise ValueError(f'expected outer loop at STL line {line_number}')\n                state = 'vertices'\n                continue\n\n            if state == 'vertices':\n                if keyword == 'vertex':\n                    if len(tokens) != 4 or len(current_vertices) >= 3:\n                        raise ValueError(f'each facet must contain exactly three vertices at STL line {line_number}')\n                    try:\n                        vertex = tuple(float(value) for value in tokens[1:4])\n                    except ValueError as exc:\n                        raise ValueError(f'non-numeric vertex at STL line {line_number}') from exc\n                    vertex_array = np.asarray(vertex, dtype=np.float64)\n                    if not np.isfinite(vertex_array).all():\n                        raise ValueError(f'non-finite vertex at STL line {line_number}')\n                    current_vertices.append(vertex)\n                    all_vertices.append(vertex)\n                elif keyword == 'endloop' and len(tokens) == 1:\n                    if len(current_vertices) != 3:\n                        raise ValueError(f'facet must contain three vertices before endloop at STL line {line_number}')\n                    vertices = np.asarray(current_vertices, dtype=np.float64)\n                    cross_product = np.cross(vertices[1] - vertices[0], vertices[2] - vertices[0])\n                    area = 0.5 * float(np.linalg.norm(cross_product))\n                    if not math.isfinite(area) or area <= 0.0:\n                        raise ValueError(f'degenerate triangle at STL line {line_number}')\n                    state = 'await_endfacet'\n                else:\n                    raise ValueError(f'expected vertex or endloop at STL line {line_number}')\n                continue\n\n            if state == 'await_endfacet':\n                if tokens != ['endfacet']:\n                    raise ValueError(f'expected endfacet at STL line {line_number}')\n                facet_count += 1\n                state = 'await_facet'\n                continue\n\n            if state == 'done':\n                raise ValueError(f'content appears after endsolid at STL line {line_number}')\n\n        if state != 'done':\n            raise ValueError('ASCII STL is truncated or missing endsolid')\n        if facet_count == 0 or len(normals) != facet_count:\n            raise ValueError('ASCII STL must contain at least one complete facet')\n        coordinates = np.asarray(all_vertices, dtype=np.float64)\n        if coordinates.shape != (facet_count * 3, 3) or not np.isfinite(coordinates).all():\n            raise ValueError('STL vertex geometry is incomplete or non-finite')\n        bounds_min = coordinates.min(axis=0)\n        bounds_max = coordinates.max(axis=0)\n        if not np.isfinite(bounds_min).all() or not np.isfinite(bounds_max).all():\n            raise ValueError('STL geometry bounds are non-finite')\n\n    @staticmethod\n    def run(geometry_file) -> dict[str, Any]:\n        filename, content = ImportStlSurface._read_input(geometry_file)\n        ImportStlSurface._validate_ascii_stl(content)\n        return {\n            'surface_mesh': {\n                'filename': filename,\n                'content': content,\n                'encoding': 'ascii',\n                'suffix': '.stl',\n            }\n        }\n",
