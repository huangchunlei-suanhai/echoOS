            "workflow_draft": {
                "name": "STL机翼50km/h升力分析与可视化",
                "goal": "将STL机翼表面几何处理为可用于外流场CFD的体网格，在50 km/h来流条件下完成稳态流场求解，计算升力及升力系数，并生成压力、速度和升力结果的可视化配置。",
                "inputs": [
                    {
                        "name": "geometry_file",
                        "description": "STL机翼外表面几何文件路径；运行时绑定，文件格式为STL表面网格。",
                        "required": true,
                        "source": "user_message"
                    },
                    {
                        "name": "freestream_velocity",
                        "description": "远场来流速度，单位m/s；用户目标50 km/h对应13.8889 m/s。",
                        "required": true,
                        "source": "user_message"
                    },
                    {
                        "name": "angle_of_attack",
                        "description": "机翼攻角，单位deg；需要依据机翼坐标系和来流方向在运行时绑定。",
                        "required": true,
                        "source": "to_be_bound"
                    },
                    {
                        "name": "air_density",
                        "description": "空气密度，单位kg/m^3；用于流体属性、雷诺数和气动力计算。",
                        "required": true,
                        "source": "to_be_bound"
                    },
                    {
                        "name": "dynamic_viscosity",
                        "description": "空气动力黏度，单位Pa·s；用于流体属性和雷诺数计算。",
                        "required": true,
                        "source": "to_be_bound"
                    },
                    {
                        "name": "reference_area",
                        "description": "机翼参考面积，单位m^2；用于升力系数计算。",
                        "required": true,
                        "source": "to_be_bound"
                    },
                    {
                        "name": "mesh_target_size",
                        "description": "外流场体网格目标尺寸，单位m；应结合机翼弦长、前缘和尾缘特征进行绑定。",
                        "required": true,
                        "source": "to_be_bound"
                    }
                ],
                "outputs": [
                    {
                        "name": "lift_metrics",
